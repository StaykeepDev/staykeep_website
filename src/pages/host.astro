    border-block: 1px solid #e3e8f4;
    background: #fff;
  }
  .hs-trust-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 2.25rem;
    margin: 0 auto;
    padding-block: 1rem;
    list-style: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-on-surface);
  }
  .hs-trust-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hs-trust-list .icon {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-primary);
  }
  .hs-shot-list {
