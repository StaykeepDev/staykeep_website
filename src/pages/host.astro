  @media (max-width: 760px) {
    .hs-hero {
      padding: 1.5rem 0 2.5rem;
    }
    .hs-trust-list {
      justify-content: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }
    .hs-plan {
      padding: 1.5rem;
    }
