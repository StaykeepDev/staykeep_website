---
/**
 * Ad landing page at /host (owner, 9 Nov 2026: was /homestay-software, which
 * now 301s here; public/_redirects). Searches like "homestay software", "hotel PMS", "property
 * management system"). Owner, 9 Nov 2026: StayKeep is a PMS, not "homestay
 * software": present it as a property management system for homestays, hotels
 * and hostels, in the standard PMS modules; price by listings (each room,
 * cottage or whole villa), ₹499 a month for up to 3 and the bigger plans, plus
 * the channel manager add-on; everything crystal clear, built for conversions.
 * Still no "free" anywhere (owner, 27 Oct 2026); only live features. Prices:
 * src/content/pricing.ts. Config (WhatsApp number, video, Google Ads id +
 * labels): src/content/ads.ts. Plan: docs/ads/google-ads-plan.md.
 */
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureList from "../components/sections/FeatureList.astro";
import Faq from "../components/sections/Faq.astro";
import AdCtas from "../components/ads/AdCtas.astro";
import Icon from "../components/Icon.astro";
import { FAQ_HOMESTAY_SOFTWARE } from "../content/faq";
import { AD_VIDEO_POSTER, AD_VIDEO_SRC, WHATSAPP_URL } from "../content/ads";
import { CHANNEL_MANAGER_ADDON, LISTING_MEANING, ROOM_PLANS, rupees } from "../content/pricing";
import { CONTACT_PHONE_TEL, CONTACT_PHONE_DISPLAY } from "../content/site";
import type { FeatureItem } from "../content/features";
import deskMonth from "../assets/screenshots/ad/desk-month.png";
import phoneCalendar from "../assets/screenshots/ad/phone-calendar.png";
import phoneWebsite from "../assets/screenshots/ad/phone-website.png";
import phoneCheckin from "../assets/screenshots/ad/phone-checkin.png";

// The current Manage web Month calendar on a computer (demo property), captured 9 Nov 2026.
const poster = await getImage({
  src: deskMonth,
  width: 1280,
  height: 720,
  fit: "cover",
  position: "top",
  format: "webp",
  quality: 70,
});

const [starter] = ROOM_PLANS;

const SHOTS = [
  {
    src: phoneCalendar,
    title: "Every room on one calendar",
    alt: "StayKeep Manage month calendar showing available rooms per day for an example homestay",
  },
  {
    src: phoneWebsite,
    title: "Your own booking website",
    alt: "An example homestay booking website at hillview.staykeep.com, previewed on a phone",
  },
  {
    src: phoneCheckin,
    title: "Check-in with verified IDs",
    alt: "StayKeep Manage check-in screen with two guests whose IDs are verified",
  },
];

const STEPS = [
  {
    title: "Send your Google Maps link",
    text: "Message us on WhatsApp with the link to your property on Google Maps.",
  },
  {
    title: "We set up your property",
    text: "Our team adds your property and listings and sets up your booking website, then shows you around on a short call.",
  },
  {
    title: "Choose your plan and go live",
    text: "Pay monthly or yearly by UPI or card, and start taking bookings.",
  },
];

const FEATURES: FeatureItem[] = [
  {
    icon: "calendar",
    title: "Reservations and room calendar",
    description:
      "Phone, walk-in, website and OTA bookings in one list, on a month view and a room-by-room timeline.",
  },
  {
    icon: "key",
    title: "Front desk",
    description:
      "Check-in and check-out, room moves, stay extensions, and a live view of arrivals, departures and guests in house.",
  },
  {
    icon: "shield-check",
    title: "Guest register and ID check-in",
    description:
      "Scan guest IDs at check-in, keep the digital guest register, print the registration card, and see the Form C list for foreign guests.",
  },
  {
    icon: "receipt",
    title: "Billing with GST",
    description:
      "Bills with GST by line and as PDF, UPI and online payments, expenses and accounts for each property.",
  },
  {
    icon: "globe",
    title: "Booking engine",
    description:
      "Your own booking website at yourname.staykeep.com, free with every plan. Guests book and pay you directly, with 0% commission.",
  },
  {
    icon: "layout",
    title: "Channel manager (add-on)",
    description:
      "Availability and prices stay in sync with booking sites like Booking.com, Agoda, Airbnb and MakeMyTrip, and their bookings come straight in.",
  },
  {
    icon: "sparkle",
    title: "Housekeeping",
    description:
      "Check-out creates the cleaning task, and housekeeping marks rooms clean from their phone.",
  },
  {
    icon: "users",
    title: "Staff and roles",
    description:
      "Reception, housekeeping and managers get their own logins, roles and tasks.",
  },
  {
    icon: "list",
    title: "Reports",
    description:
      "Occupancy, money collected and insights for every property, with one login for all your properties.",
  },
];
---

<BaseLayout
  title={`PMS for homestays, hotels and hostels, ${rupees(starter.monthly)} a month | StayKeep`}
  description={`StayKeep is a property management system (PMS) for homestays, hotels and hostels in India: reservations, front desk, room calendar, ID check-in, GST billing, booking engine and channel manager. ${rupees(starter.monthly)} a month for up to 3 listings, 0% commission on bookings. Our team sets it up for you.`}
  path="/host"
  faq={FAQ_HOMESTAY_SOFTWARE}
>
  <section class="hs-hero">
    <div class="container hs-hero-grid">
      <div>
        <p class="eyebrow">PMS for homestays, hotels and hostels</p>
        <h1 class="display-1">
          Property management system for {rupees(starter.monthly)} a month
        </h1>
        <p class="lede">
          Reservations, front desk, room calendar, guest register,
          housekeeping, GST billing and your own booking engine. One PMS on
          your phone and computer.
        </p>
        <ul class="hs-facts">
          <li>
            <Icon name="check" />
            <span>
              <strong>{rupees(starter.monthly)} a month</strong> for up to 3 listings.{" "}
              <a href="#pricing" class="hs-inline-link">See all plans</a>
            </span>
          </li>
          <li><Icon name="check" /><span><strong>Free booking website</strong> with every plan</span></li>
          <li><Icon name="check" /><span><strong>0% commission</strong> on your bookings</span></li>
          <li><Icon name="check" /><span><strong>Our team sets it up</strong> for you</span></li>
        </ul>
        <div id="hs-hero-ctas">
          <AdCtas location="hero" />
        </div>
      </div>
      <figure class="hs-video">
        {
          AD_VIDEO_SRC ? (
            <video
              controls
              playsinline
              preload="none"
              poster={AD_VIDEO_POSTER || poster.src}
              width="1280"
              height="720"
              aria-label="StayKeep for homestays, 31 second video with voice"
            >
              <source src={AD_VIDEO_SRC} type="video/mp4" />
            </video>
          ) : (
            <img
              src={poster.src}
              width="1280"
              height="720"
              alt="StayKeep PMS month calendar on a computer, showing free listings per night for an example homestay"
              fetchpriority="high"
              decoding="async"
            />
          )
        }
      </figure>
    </div>
  </section>

  <section class="hs-trust" aria-label="About us">
    <ul class="container hs-trust-list">
      <li><Icon name="building" /> STAYKEEP (OPC) Pvt Ltd</li>
      <li><Icon name="phone" /> Android app on Google Play</li>
      <li><Icon name="globe" /> Works in any browser</li>
      <li><Icon name="chat" /> Our team replies on WhatsApp</li>
    </ul>
  </section>

  <section class="section hs-shots" aria-labelledby="hs-shots-heading">
    <div class="container">
      <p class="eyebrow">The real app</p>
      <h2 class="display-2" id="hs-shots-heading">Your PMS, on your phone.</h2>
      <ul class="hs-shot-list">
        {
          SHOTS.map((shot) => (
            <li>
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[280, 560]}
                sizes="(max-width: 760px) 70vw, 280px"
                format="webp"
                quality={72}
                loading="lazy"
                decoding="async"
              />
              <p>{shot.title}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FeatureList
    id="hs-features-heading"
    eyebrow="What's in the PMS"
    heading="A complete PMS, in one app."
    items={FEATURES}
  />

  <section class="section hs-pricing" id="pricing" aria-labelledby="hs-pricing-heading">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h2 class="display-2" id="hs-pricing-heading">One clear price, by your number of listings.</h2>
      <div class="hs-pricing-grid">
        <div class="hs-plan">
          <p class="hs-plan-rooms">{starter.listings}</p>
          <p class="hs-plan-price">
            <span class="hs-plan-amount">{rupees(starter.monthly)}</span>
            <span class="hs-plan-per">a month</span>
          </p>
          <p class="hs-plan-year">
            or {rupees(starter.yearly)} a year: 12 months for the price of 10
          </p>
          <ul class="hs-plan-list">
            <li><Icon name="check" /> Every PMS feature on this page</li>
            <li><Icon name="check" /> Free booking website</li>
            <li><Icon name="check" /> 0% commission on your bookings</li>
            <li><Icon name="check" /> Setup by our team</li>
            <li><Icon name="check" /> No GST added</li>
            <li><Icon name="check" /> Cancel any time</li>
          </ul>
          <a
            href={WHATSAPP_URL}
            class="btn btn-primary hs-plan-cta"
            target="_blank"
            rel="noopener"
            data-cta="whatsapp"
            data-cta-location="pricing"
          >
            <Icon name="chat" /> WhatsApp your Maps link
          </a>
        </div>
        <div class="hs-tiers">
          <table>
            <caption>All plans, per property</caption>
            <thead>
              <tr>
                <th scope="col">Listings</th>
                <th scope="col">Monthly</th>
                <th scope="col">Yearly</th>
              </tr>
            </thead>
            <tbody>
              {
                ROOM_PLANS.map((plan, i) => (
                  <tr class={i === 0 ? "hs-tier-first" : undefined}>
                    <th scope="row">{plan.listings}</th>
                    <td>{rupees(plan.monthly)}</td>
                    <td>{rupees(plan.yearly)}</td>
                  </tr>
                ))
              }
              <tr>
                <th scope="row">More than 100 listings</th>
                <td colspan="2">
                  <a href={CONTACT_PHONE_TEL} class="text-link" data-cta="call" data-cta-location="pricing">
                    Call {CONTACT_PHONE_DISPLAY}
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
          <p class="hs-tiers-note">
            {LISTING_MEANING} Every plan has every PMS feature. Pay by UPI or
            card.
          </p>
          <div class="hs-addon" aria-labelledby="hs-addon-heading">
            <h3 class="hs-addon-title" id="hs-addon-heading">
              <Icon name="layout" /> Channel manager add-on
            </h3>
            <p class="hs-addon-text">
              Keep availability and prices in sync with booking sites like
              Booking.com, Agoda, Airbnb and MakeMyTrip. Added on top of your
              plan.
            </p>
            <ul class="hs-addon-list">
              {
                CHANNEL_MANAGER_ADDON.map((a) => (
                  <li>
                    <span>{a.listings}</span>
                    <strong>{rupees(a.monthly)} a month</strong>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section hs-steps-section" aria-labelledby="hs-steps-heading">
    <div class="container">
      <p class="eyebrow">How to start</p>
      <h2 class="display-2" id="hs-steps-heading">Three steps, and you are live.</h2>
      <ol class="hs-steps">
        {
          STEPS.map((step, i) => (
            <li>
              <span class="hs-step-number">{i + 1}</span>
              <h3 class="display-4">{step.title}</h3>
              <p class="body-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Faq items={FAQ_HOMESTAY_SOFTWARE} />

  <section class="hs-end" aria-labelledby="hs-end-heading">
    <div class="container">
      <div class="hs-end-box" id="hs-end-box">
        <h2 class="display-3" id="hs-end-heading">
          WhatsApp your Google Maps link. We'll set up your PMS.
        </h2>
        <p class="lede">
          Our team adds your property and listings and shows you around.
          {rupees(starter.monthly)} a month for up to 3 listings, free booking website, 0% commission.
        </p>
        <AdCtas location="footer" />
      </div>
    </div>
  </section>

  <div class="hs-sticky" id="hs-sticky" aria-label="Contact StayKeep" role="region" hidden>
    <a
      href={WHATSAPP_URL}
      class="btn btn-primary"
      target="_blank"
      rel="noopener"
      data-cta="whatsapp"
      data-cta-location="sticky"
    >
      <Icon name="chat" /> WhatsApp us
    </a>
    <a href={CONTACT_PHONE_TEL} class="btn btn-outline" data-cta="call" data-cta-location="sticky">
      <Icon name="phone" /> Call
    </a>
  </div>
</BaseLayout>

<script>
  // Carry the ad's utm_* and gclid to the sign-up link only.
  const params = new URLSearchParams(location.search);
  const keep = [...params].filter(
    ([key]) => key.startsWith("utm_") || key === "gclid",
  );
  if (keep.length > 0) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
      'a[data-cta="signup"]',
    )) {
      const url = new URL(link.href);
      for (const [key, value] of keep) url.searchParams.set(key, value);
      link.href = url.toString();
    }
  }

  // Phones: WhatsApp and Call stay at hand once the hero's buttons scroll away,
  // and step aside while the closing box (with the same buttons) is on screen.
  const bar = document.getElementById("hs-sticky");
  const hero = document.getElementById("hs-hero-ctas");
  const end = document.getElementById("hs-end-box");
  if (bar && hero && end && "IntersectionObserver" in window) {
    const seen = new Map<Element, boolean>([
      [hero, true],
      [end, false],
    ]);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) seen.set(e.target, e.isIntersecting);
      bar.hidden = seen.get(hero) === true || seen.get(end) === true;
    });
    io.observe(hero);
    io.observe(end);
  }
</script>

<style>
  .hs-hero {
    padding: 3rem 0 3.5rem;
    background: linear-gradient(#f5f7ff, #fff);
  }
  .hs-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hs-hero h1 {
    font-size: clamp(2rem, 4vw, 3.3rem);
  }
  .hs-hero .lede {
    margin-top: 1.1rem;
    max-width: 34rem;
  }
  .hs-facts {
    display: grid;
    gap: 0.55rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1.02rem;
    color: var(--color-on-surface);
  }
  .hs-facts li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }
  .hs-facts .icon,
  .hs-plan-list .icon {
    flex: 0 0 auto;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.15rem;
    color: var(--color-primary);
  }
  .hs-inline-link {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .hs-video {
    margin: 0;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #dbe3f5;
    background: #edf2ff;
  }
