---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import CommissionStory from "../components/sections/CommissionStory.astro";
import TwoDoors from "../components/sections/TwoDoors.astro";
import CalculatorSection from "../components/sections/CalculatorSection.astro";
import ProductShowcase from "../components/sections/ProductShowcase.astro";
import OwnWebsite from "../components/sections/OwnWebsite.astro";
import ComparisonTable from "../components/sections/ComparisonTable.astro";
import Faq from "../components/sections/Faq.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { FAQ_HOME } from "../content/faq";
import { DEFAULT_OG_DESCRIPTION } from "../content/site";
---

<BaseLayout
  title="StayKeep — great stays, zero booking commission"
  description={DEFAULT_OG_DESCRIPTION}
  path="/"
>
  <Hero />
  <CommissionStory />
  <TwoDoors />
  <ProductShowcase variant="home" />
  <OwnWebsite />
  <CalculatorSection />
  <ComparisonTable />
  <Faq items={FAQ_HOME} />
  <FinalCta />
</BaseLayout>
