---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { APP_STAYS_URL } from "../content/site";
---

<BaseLayout
  title="Page not found | StayKeep"
  description="This page has checked out. Find your way back to StayKeep."
  path="/404"
>
  <section class="section not-found">
    <div class="container">
      <span class="error-code" aria-hidden="true">
        404
      </span>
      <p class="eyebrow">Looks like a wrong turn</p>
      <h1 class="display-1">
        This page has
        <br />
        checked out.
      </h1>
      <p class="lede">
        The link may have moved, but your next stay is still out there.
      </p>
      <div class="actions">
        <a href="/" class="btn btn-primary">
          Back to home <Icon name="arrow-right" />
        </a>
        <a href={APP_STAYS_URL} class="btn btn-outline">
          Find a stay
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .not-found {
    text-align: center;
    background: linear-gradient(#f3f6ff, #fff);
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .error-code {
    display: block;
    font-size: clamp(5rem, 13vw, 9rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.08em;
    color: #dce5ff;
    margin-bottom: 1.5rem;
  }
  .not-found h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
  }
  .not-found .lede {
    max-width: 30rem;
    margin: 1.5rem auto 0;
  }
  .not-found .actions {
    justify-content: center;
  }
</style>
