---
import BaseLayout from "../layouts/BaseLayout.astro";
import OwnersHero from "../components/sections/OwnersHero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import FeatureList from "../components/sections/FeatureList.astro";
import ProductShowcase from "../components/sections/ProductShowcase.astro";
import OwnWebsiteDetailed from "../components/sections/OwnWebsiteDetailed.astro";
import CalculatorSection from "../components/sections/CalculatorSection.astro";
import Faq from "../components/sections/Faq.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { OWNER_FEATURES } from "../content/features";
import { FAQ_OWNERS } from "../content/faq";
---

<BaseLayout
  title="For property owners — keep more of every booking | StayKeep"
  description="Take direct bookings at 0% commission. Run rooms, check-in, staff, guest conversations and billing with StayKeep Manage."
  path="/owners"
>
  <OwnersHero />
  <HowItWorks />
  <FeatureList
    id="owner-features-heading"
    eyebrow="One place for the everyday"
    heading="You take care of your guests. We help with the rest."
    lede="The tools your team needs, from the first enquiry to the final invoice."
    items={OWNER_FEATURES}
  />
  <ProductShowcase variant="owners" />
  <OwnWebsiteDetailed />
  <CalculatorSection />
  <Faq items={FAQ_OWNERS} />
  <FinalCta variant="owners" />
</BaseLayout>
