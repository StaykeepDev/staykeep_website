---
import { ANALYTICS_ENABLED, ADS_ENABLED } from "../lib/analytics-config";
---

{
  ANALYTICS_ENABLED && (
    <div
      id="sk-consent"
      class="sk-consent"
      role="region"
      aria-label="Cookie consent"
      hidden
    >
      <p>
        {ADS_ENABLED
          ? "We use cookies to understand how StayKeep is used and to measure our ads."
          : "We use cookies to understand how StayKeep is used."}
      </p>
      <div class="sk-consent-actions">
        <button type="button" data-consent="denied">
          Decline
        </button>
        <button type="button" data-consent="granted" class="sk-consent-accept">
          Accept
        </button>
      </div>
    </div>
  )
}
<script>
  /**
   * A3/A6 - GA4 + Microsoft Clarity behind consent, the light inline twin of
   * `@staykeep/web-core`'s analytics module.
   *
   * Consent Mode v2, advanced (owner, 9 Nov 2026: "yes" to counting the
   * visitors who never answer the banner). Every Google tag (GA4, Ads, the
   * GTM container) starts `denied` and, while the visitor has NOT chosen yet,
   * loads in that state: no cookies, only cookieless pings Google models
   * visits and conversions from (`ads_data_redaction`, `url_passthrough`).
   * Accept grants analytics_storage, ad_storage and ad_user_data
   * (ad_personalization stays denied) and loads Clarity; Clarity never loads
   * before Accept. A stored Decline loads nothing at all, and no event of
   * ours is sent after Decline.
   * The choice lives in localStorage `sk_consent` (try/catch: storage can be
   * blocked). Events carry no PII: only fixed event names and parameters.
   *
   * Ad landing CTAs (`data-cta` = whatsapp | call | signup, plus
   * `data-cta-location`) send `<cta>_click` with `cta_location` and `page`,
   * and, when `GOOGLE_ADS_ID` and that CTA's label are set in
   * src/content/ads.ts, a Google Ads conversion. Ads loads only after Accept.
   *
   * Google Tag Manager (`GTM_ID` in src/content/ads.ts, owner 9 Nov 2026) is
   * the official container snippet, injected only after Accept too; each CTA
   * click also pushes `cta_<cta>` to the dataLayer for its triggers, and a
   * same-tab link waits for the container (at most 800 ms) before leaving.
   */
  import { GOOGLE_ADS_ID, GOOGLE_ADS_LABELS, GTM_ID } from "../content/ads";
  const GA4 = (import.meta.env.PUBLIC_GA4_ID ?? "").trim();
  const ADS = GOOGLE_ADS_ID.trim();
  const GTM = GTM_ID.trim();
  const ADS_LABELS: Record<string, string> = GOOGLE_ADS_LABELS;
  const CLARITY = (import.meta.env.PUBLIC_CLARITY_ID ?? "").trim();
  const KEY = "sk_consent";

  type AnyWindow = Window & {
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
    clarity?: ((...args: unknown[]) => void) & { q?: unknown[] };
  };
  const w = window as AnyWindow;

  function read(): "granted" | "denied" | null {
    try {
      const v = window.localStorage.getItem(KEY);
      if (v === "granted" || v === "denied") return v;
    } catch {
      /* storage blocked */
    }
    return memory;
  }
  let memory: "granted" | "denied" | null = null;

  function inject(src: string): void {
    const s = document.createElement("script");
    s.async = true;
    s.src = src;
    document.head.appendChild(s);
  }

  let gaLoaded = false;
  let gtmLoaded = false;
  let clarityLoaded = false;

  function defineGtag(): void {
    w.dataLayer = w.dataLayer ?? [];
    const layer = w.dataLayer;
    w.gtag =
      w.gtag ??
      function () {
        // gtag.js reads `arguments` objects, not arrays.
        // eslint-disable-next-line prefer-rest-params
        layer.push(arguments);
      };
    w.gtag("consent", "default", {
      analytics_storage: "denied",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      wait_for_update: 500,
    });
    // Cookieless while denied: no ad identifiers, the ad click id kept in links instead.
    w.gtag("set", "ads_data_redaction", true);
    w.gtag("set", "url_passthrough", true);
    w.gtag("js", new Date());
    if (GA4) {
      w.gtag("config", GA4, {
        send_page_view: false,
        allow_google_signals: false,
        linker: { domains: ["staykeep.com", "app.staykeep.com"] },
      });
    }
    if (ADS) w.gtag("config", ADS);
  }

  /** Accept: Ads measures conversions only, so ad_personalization stays denied. */
  function grant(): void {
    w.gtag?.("consent", "update", {
      analytics_storage: "granted",
      ...(ADS || GTM ? { ad_storage: "granted", ad_user_data: "granted" } : {}),
    });
  }

  /** The Google tags, in whatever consent state is current (denied until Accept). */
  function loadGoogle(): void {
    if ((GA4 || ADS) && !gaLoaded) {
      gaLoaded = true;
      inject(
        "https://www.googletagmanager.com/gtag/js?id=" +
          encodeURIComponent(GA4 || ADS),
      );
      // The marketing site has no ids in its paths: send the plain path.
      if (GA4) {
        w.gtag?.("event", "page_view", {
          page_path: location.pathname,
          page_location: location.origin + location.pathname,
          page_title: document.title,
        });
      }
    }
    if (GTM && !gtmLoaded) {
      gtmLoaded = true;
      // The official container snippet: the gtm.js start event, then the loader.
      w.dataLayer = w.dataLayer ?? [];
      w.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      inject("https://www.googletagmanager.com/gtm.js?id=" + encodeURIComponent(GTM));
    }
  }

  /** Accept: grant first, so the page view goes out with the visitor's consent. */
  function load(): void {
    grant();
    loadGoogle();
    if (CLARITY && !clarityLoaded) {
      clarityLoaded = true;
      const c: NonNullable<AnyWindow["clarity"]> =
        w.clarity ??
        function (...args: unknown[]) {
          (c.q = c.q ?? []).push(args);
        };
      w.clarity = c;
      inject("https://www.clarity.ms/tag/" + encodeURIComponent(CLARITY));
      c("consent");
    }
  }

  function apply(): void {
    const choice = read();
    if (choice === "granted") load();
    else if (choice === null) loadGoogle();
    else {
      if (gaLoaded || gtmLoaded) {
        w.gtag?.("consent", "update", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
        });
      }
      if (clarityLoaded) w.clarity?.("consent", false);
    }
  }

  function track(name: string, params: Record<string, unknown> = {}): void {
    // Cookieless before a choice, never after Decline.
    if (read() === "denied" || !gaLoaded) return;
    w.gtag?.("event", name, params);
  }

  /**
   * Ad landing CTA: GA4 event, an optional Ads conversion and the GTM
   * `cta_<cta>` event. True if it navigates for us.
   */
  function trackCta(link: HTMLAnchorElement, event: MouseEvent): boolean {
    const cta = link.dataset.cta ?? "";
    const params = {
      cta_location: link.dataset.ctaLocation ?? "",
      page: location.pathname,
    };
    track(cta + "_click", params);
    if (read() === "denied") return false;
    const label = ADS_LABELS[cta] ?? "";
    const ads = ADS !== "" && label !== "" && gaLoaded;
    if (!ads && !gtmLoaded) return false;
    // Same-tab links (sign-up) wait briefly so the conversion is sent first.
    const sameTab =
      !link.target &&
      !link.href.startsWith("tel:") &&
      !event.metaKey &&
      !event.ctrlKey &&
      !event.shiftKey &&
      event.button === 0;
    let go: (() => void) | undefined;
    if (sameTab) {
      event.preventDefault();
      let gone = false;
      go = (): void => {
        if (gone) return;
        gone = true;
        location.href = link.href;
      };
      window.setTimeout(go, 800);
    }
    if (ads) {
      w.gtag?.("event", "conversion", {
        send_to: ADS + "/" + label,
        ...(go ? { event_callback: go } : {}),
      });
    }
    if (gtmLoaded) {
      w.dataLayer?.push({
        event: "cta_" + cta,
        ...params,
        ...(go ? { eventCallback: go, eventTimeout: 800 } : {}),
      });
    }
    return sameTab;
  }

  if (GA4 || CLARITY || ADS || GTM) {
    if (GA4 || ADS || GTM) defineGtag();
    const banner = document.getElementById("sk-consent");
    const sync = (): void => {
      if (banner) banner.hidden = read() !== null;
    };
    const choose = (choice: "granted" | "denied"): void => {
      memory = choice;
      try {
        window.localStorage.setItem(KEY, choice);
      } catch {
        /* storage blocked: the in-memory value holds for this visit */
      }
      sync();
      apply();
    };
    sync();
    apply();

    document.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      const choiceButton = target?.closest<HTMLElement>("[data-consent]");
      if (choiceButton) {
        choose(choiceButton.dataset.consent === "granted" ? "granted" : "denied");
        return;
      }
      if (target?.closest("[data-cookie-settings]")) {
        if (banner) banner.hidden = false;
        return;
      }
      const link = target?.closest<HTMLAnchorElement>("a[href]");
      if (!link) return;
      if (link.dataset.cta) {
        trackCta(link, event);
        return;
      }
      const href = link.getAttribute("href") ?? "";
      if (href.startsWith("mailto:") || href.startsWith("tel:")) {
        track("contact_click");
        return;
      }
      let host = "";
      try {
        host = new URL(href, location.href).host;
      } catch {
        return;
      }
      if (host === "app.staykeep.com") track("cta_find_a_stay");
      else if (host === "manage.staykeep.com") track("cta_owner_sign_in");
    });

    // The hero search is a plain GET form that submits to the guest app.
    document.addEventListener("submit", (event) => {
      const form = event.target as HTMLFormElement | null;
      if (form?.action && new URL(form.action, location.href).host === "app.staykeep.com") {
        track("cta_find_a_stay");
      }
    });
  }
</script>
<style>
  .sk-consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    padding: 0.75rem 1rem;
    background: #ffffff;
    color: #14213d;
    border-top: 1px solid #d5dbe8;
    font-size: 0.875rem;
  }
  .sk-consent[hidden] {
    display: none;
  }
  .sk-consent p {
    margin: 0;
  }
  .sk-consent-actions {
    display: flex;
    gap: 0.5rem;
  }
  .sk-consent button {
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid #315ed2;
    background: #ffffff;
    color: #315ed2;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .sk-consent button.sk-consent-accept {
    background: #315ed2;
    color: #ffffff;
  }
  .sk-consent button:focus-visible {
    outline: 2px solid #315ed2;
    outline-offset: 2px;
  }
</style>
