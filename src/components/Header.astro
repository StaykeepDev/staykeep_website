---
import Logo from './Logo.astro';
import { PRIMARY_NAV, MANAGE_URL } from '../content/site';

const path = new URL(Astro.request.url).pathname;
---

<header class="site-header">
  <div class="container site-header-inner">
    <Logo />

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {PRIMARY_NAV.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link"
              aria-current={!link.external && path === link.href ? 'page' : undefined}
              {...(link.external ? { rel: 'noopener' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={MANAGE_URL} class="nav-link header-signin" rel="noopener">Owner sign in</a>
      <a href="/owners" class="btn btn-primary btn-sm">List your property</a>
    </div>

    <button
      type="button"
      class="menu-toggle tap-target"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="visually-hidden">Open menu</span>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <ul>
        {PRIMARY_NAV.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link" {...(link.external ? { rel: 'noopener' } : {})}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a href={MANAGE_URL} class="mobile-nav-link" rel="noopener">Owner sign in</a>
        </li>
      </ul>
      <a href="/owners" class="btn btn-primary btn-block mobile-menu-cta">List your property</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 72px;
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
  }

  .nav-link {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    padding: 0.5rem 0;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-on-surface);
  }

  .header-actions {
    display: none;
    align-items: center;
    gap: var(--space-md);
  }

  .header-signin {
    white-space: nowrap;
  }

  .menu-toggle {
    display: inline-flex;
    background: none;
    border: none;
    border-radius: var(--radius-pill);
    color: var(--color-on-surface);
    cursor: pointer;
  }

  .mobile-menu {
    border-top: 1px solid var(--color-outline-variant);
    background: var(--color-surface);
    padding: var(--space-md) var(--container-pad) var(--space-lg);
  }

  .mobile-menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-cta {
    margin-top: 1rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.9rem 0;
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-on-surface);
    border-bottom: 1px solid var(--color-outline-variant);
  }

  @media (min-width: 900px) {
    .nav-desktop,
    .header-actions {
      display: flex;
    }
    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.hidden = isOpen;
    });

    // Collapse the mobile menu if the viewport grows past the breakpoint
    // where the desktop nav takes over, so it can't be left open underneath.
    const desktopQuery = window.matchMedia('(min-width: 900px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.hidden = true;
      }
    });
  }
</script>
