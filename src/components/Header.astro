---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { PRIMARY_NAV, MANAGE_URL } from "../content/site";
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header-inner">
    <Logo />
    <nav class="nav-desktop" aria-label="Primary">
      {PRIMARY_NAV.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a href={MANAGE_URL} class="owner-login">
      Owner sign in <Icon name="arrow-right" />
    </a>
    <button
      type="button"
      class="menu-toggle tap-target"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
  <nav
    class="mobile-menu container"
    id="mobile-menu"
    aria-label="Mobile"
    hidden
  >
    {PRIMARY_NAV.map((link) => (
      <a
        href={link.href}
        aria-current={path === link.href ? "page" : undefined}
      >
        {link.label}
      </a>
    ))}
    <a href={MANAGE_URL}>
      Owner sign in <Icon name="arrow-right" />
    </a>
  </nav>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fafbfeed;
    backdrop-filter: blur(16px);
    border-bottom: 1px solid #e4e8ef;
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: var(--header-height);
  }
  .nav-desktop {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .nav-desktop a,
  .owner-login {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-desktop a {
    color: var(--color-on-surface-variant);
    padding: 1rem 0;
  }
  .nav-desktop a:hover,
  .nav-desktop a[aria-current] {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 8px;
  }
  .owner-login {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--color-outline-variant);
    border-radius: 100px;
    padding: 0.7rem 1.1rem;
  }
  .owner-login:hover {
    background: var(--color-primary-container);
  }
  .owner-login .icon {
    width: 1.1rem;
  }
  .menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--color-outline-variant);
    border-radius: 50%;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu {
    padding-block: 0.5rem 1.5rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-outline-variant);
  }
  .mobile-menu a {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-outline-variant);
    display: flex;
    justify-content: space-between;
    font-weight: 600;
  }
  .mobile-menu a[aria-current] {
    color: var(--color-primary);
  }
  @media (max-width: 1000px) {
    .nav-desktop {
      gap: 1.15rem;
    }
    .site-header-inner {
      gap: 1rem;
    }
    .owner-login {
      padding: 0.7rem;
    }
    .owner-login .icon {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .site-header-inner {
      min-height: var(--header-height);
    }
    .nav-desktop,
    .owner-login {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
    .mobile-menu {
      max-height: calc(100dvh - var(--header-height));
      overflow: auto;
    }
  }
  @media (min-width: 861px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      menu.hidden = true;
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        close();
        toggle.focus();
      }
    });
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) close();
    });
    window
      .matchMedia("(min-width:861px)")
      .addEventListener("change", (event) => {
        if (event.matches) close();
      });
  }
</script>
