---
/**
 * A small, hand-drawn set of line icons (24x24, stroke-based, currentColor) —
 * no icon package, per the brief. Sized/coloured by the shared `.icon` class
 * in global.css; pass `size` or a `class` to override in place.
 */
interface Props {
  name:
    | 'search'
    | 'map-pin'
    | 'chat'
    | 'mic'
    | 'receipt'
    | 'calendar'
    | 'shield-check'
    | 'users'
    | 'list'
    | 'globe'
    | 'phone'
    | 'mail'
    | 'check'
    | 'x'
    | 'arrow-right'
    | 'wallet'
    | 'building'
    | 'palette'
    | 'layout'
    | 'key'
    | 'bell'
    | 'sparkle';
  size?: number;
  class?: string;
}

const { name, size, class: className = '' } = Astro.props;
// Width/height as SVG presentation attributes rather than a `style="..."`
// string — the site's CSP has no `style-src 'unsafe-inline'`, so an inline
// style attribute would simply be dropped by the browser.
const dims = size ? { width: size, height: size } : {};
---

<svg class={`icon ${className}`} {...dims} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16.2" y2="16.2" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M12 21s-6.5-6.8-6.5-11.2a6.5 6.5 0 1 1 13 0C18.5 14.2 12 21 12 21Z" />
      <circle cx="12" cy="9.8" r="2.3" />
    </>
  )}
  {name === 'chat' && (
    <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5c-1.1 0-2.1-.2-3-.6L4 20l1.6-4.2a7.5 7.5 0 1 1 14.4-4.3Z" />
  )}
  {name === 'mic' && (
    <>
      <rect x="9" y="2.5" width="6" height="11" rx="3" />
      <path d="M5.5 11v.5a6.5 6.5 0 0 0 13 0V11" />
      <line x1="12" y1="18" x2="12" y2="21.5" />
      <line x1="8.5" y1="21.5" x2="15.5" y2="21.5" />
    </>
  )}
  {name === 'receipt' && (
    <>
      <path d="M6 3h12v18l-2.5-1.5L13 21l-2.5-1.5L8 21l-2-1.5V3Z" />
      <line x1="9" y1="8" x2="15" y2="8" />
      <line x1="9" y1="12" x2="15" y2="12" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="4.5" width="17" height="16" rx="2.5" />
      <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" />
      <line x1="8" y1="2.5" x2="8" y2="6.5" />
      <line x1="16" y1="2.5" x2="16" y2="6.5" />
      <path d="M8.2 14.3 10 16l4-4" />
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M12 3.2 19.5 6v6.3c0 4.7-3.3 7.6-7.5 8.5-4.2-.9-7.5-3.8-7.5-8.5V6L12 3.2Z" />
      <path d="M9 12.2l2.1 2.1L15.5 10" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8.5" r="3.2" />
      <path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" />
      <circle cx="17.2" cy="9.3" r="2.5" />
      <path d="M15.8 14.7c2.6.3 4.7 2.3 4.7 5.3" />
    </>
  )}
  {name === 'list' && (
    <>
      <line x1="9" y1="6.5" x2="20.5" y2="6.5" />
      <line x1="9" y1="12" x2="20.5" y2="12" />
      <line x1="9" y1="17.5" x2="20.5" y2="17.5" />
      <path d="M4.3 6.5h.2M4.3 12h.2M4.3 17.5h.2" stroke-width="2.4" />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <ellipse cx="12" cy="12" rx="3.6" ry="8.5" />
      <line x1="3.5" y1="12" x2="20.5" y2="12" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="3" y="5.5" width="18" height="14" rx="2.5" />
      <path d="M4 7l8 6.2L20 7" />
    </>
  )}
  {name === 'phone' && (
    <>
      <rect x="6.5" y="2.5" width="11" height="19" rx="2.5" />
      <line x1="10.3" y1="18.3" x2="13.7" y2="18.3" />
    </>
  )}
  {name === 'check' && <path d="M4.5 12.5 9.5 17.5 19.5 6.5" />}
  {name === 'x' && (
    <>
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </>
  )}
  {name === 'arrow-right' && (
    <>
      <line x1="4" y1="12" x2="19" y2="12" />
      <path d="M13.5 6.5 19.5 12l-6 5.5" />
    </>
  )}
  {name === 'wallet' && (
    <>
      <path d="M3.5 7.5A2.5 2.5 0 0 1 6 5h12a2.5 2.5 0 0 1 2.5 2.5V17a2.5 2.5 0 0 1-2.5 2.5H6A2.5 2.5 0 0 1 3.5 17Z" />
      <path d="M14.5 13a1.5 1.5 0 1 0 0 .1Z" />
      <path d="M20.5 11h-5a2 2 0 1 0 0 4h5" />
    </>
  )}
  {name === 'building' && (
    <>
      <rect x="4" y="3" width="10" height="18" rx="1" />
      <rect x="14" y="9" width="6" height="12" rx="1" />
      <line x1="7" y1="7" x2="7" y2="7.01" />
      <line x1="11" y1="7" x2="11" y2="7.01" />
      <line x1="7" y1="11" x2="7" y2="11.01" />
      <line x1="11" y1="11" x2="11" y2="11.01" />
      <line x1="7" y1="15" x2="7" y2="15.01" />
      <line x1="11" y1="15" x2="11" y2="15.01" />
    </>
  )}
  {name === 'palette' && (
    <path d="M12 3.5a8.5 8.5 0 1 0 0 17c1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8h2c2 0 3.7-1.7 3.7-3.7 0-4-4.1-7.3-8.3-7.3Zm-4.3 6.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm3-3.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4.3.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm2.7 3.7a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z" />
  )}
  {name === 'layout' && (
    <>
      <rect x="3.5" y="4" width="17" height="16" rx="2" />
      <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" />
      <line x1="9.5" y1="9.5" x2="9.5" y2="20" />
    </>
  )}
  {name === 'key' && (
    <>
      <circle cx="8" cy="15.5" r="4" />
      <path d="M11 12.5 19.5 4M16.5 7l2.5 2.5M14 9.5l2 2" />
    </>
  )}
  {name === 'bell' && (
    <>
      <path d="M6 10.5a6 6 0 1 1 12 0c0 3 1 4.5 1.8 5.5H4.2C5 15 6 13.5 6 10.5Z" />
      <path d="M10 19a2 2 0 0 0 4 0" />
    </>
  )}
  {name === 'sparkle' && (
    <path d="M12 3.5 13.6 9l5.4 1.6-5.4 1.6L12 17.7l-1.6-5.5L5 10.6l5.4-1.6Z" />
  )}
</svg>
