---
import { FEE_FOOTNOTE } from '../../content/site';
import type { FaqItem } from '../../content/faq';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const needsFootnote = items.some((item) => item.showFeeFootnote);
---

<section class="section" aria-labelledby="faq-heading">
  <div class="container container-narrow">
    <div class="section-heading">
      <p class="eyebrow">Questions</p>
      <h2 class="display-2" id="faq-heading">Frequently asked questions</h2>
    </div>

    <div class="faq-list">
      {items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            <span>{item.question}</span>
            <svg class="icon faq-icon" viewBox="0 0 24 24" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>

    {needsFootnote && <p class="fee-footnote">{FEE_FOOTNOTE}</p>}
  </div>
</section>

<style>
  .container-narrow {
    max-width: 780px;
  }

  .faq-list {
    border-top: 1px solid var(--color-outline-variant);
  }
</style>
