---
import ManageDemo from "../demos/ManageDemo.astro";
import Icon from "../Icon.astro";
interface Props {
  variant?: "home" | "owners";
}
const { variant = "home" } = Astro.props;
const allScreens = [
  {
    view: "bookings" as const,
    label: "Bookings",
    title: "Less juggling.\nMore welcoming.",
    text: "From the first enquiry to the last check-out. Keep arrivals, room details and booking status in one calm, clear view.",
    detail: "Every reservation. One place.",
    icon: "key" as const,
  },
  {
    view: "availability" as const,
    label: "Availability",
    title: "Every room.\nEvery possibility.",
    text: "See what’s booked and what’s free. Plan your days with a room calendar that keeps everyone on the same page.",
    detail: "Know what’s next, at a glance.",
    icon: "calendar" as const,
  },
  {
    view: "billing" as const,
    label: "Billing",
    title: "A clearer picture.\nDown to the rupee.",
    text: "Room charges, payments and the balance left to settle. Bring every part of a guest’s bill together.",
    detail: "From booking to final invoice.",
    icon: "receipt" as const,
  },
  {
    view: "conversations" as const,
    label: "Conversations",
    title: "A warm welcome.\nBefore they arrive.",
    text: "Keep guest conversations, requests and voice messages together in a dedicated thread for each stay.",
    detail: "A direct connection to every guest.",
    icon: "chat" as const,
  },
];
const screens = variant === "home" ? allScreens.slice(0, 3) : allScreens;
---

<section
  class="product-story"
  data-product-story
  aria-labelledby="showcase-heading"
>
  <div class="container">
    <div class="product-heading" data-reveal>
      <div>
        <p class="eyebrow">Meet StayKeep Manage</p>
        <h2 id="showcase-heading">Hosting, in harmony.</h2>
      </div>
      <p>
        One place for the everyday.
        <br />
        More time for the extraordinary.
      </p>
    </div>
    <div class="product-walkthrough">
      <div class="product-chapters">
        {screens.map((screen, index) => (
          <article
            class="product-chapter"
            data-product-chapter={index}
            id={`manage-${screen.label.toLowerCase()}`}
          >
            <div class="chapter-copy">
              <span class="chapter-index">
                0{index + 1} <span>/ {screen.label}</span>
              </span>
              <h3>
                {screen.title.split("\n").map((line) => (
                  <span>{line}</span>
                ))}
              </h3>
              <p>{screen.text}</p>
              <div class="chapter-detail">
                <Icon name={screen.icon} />
                <span>{screen.detail}</span>
              </div>
              {index === screens.length - 1 && (
                <a
                  href={
                    variant === "home"
                      ? "/owners"
                      : "https://manage.staykeep.com"
                  }
                  class="text-link"
                >
                  {variant === "home"
                    ? "Explore StayKeep Manage"
                    : "List your property"}{" "}
                  <Icon name="arrow-right" />
                </a>
              )}
            </div>
            <div class="chapter-mobile-screen">
              <ManageDemo view={screen.view} />
            </div>
          </article>
        ))}
      </div>
      <div class="product-viewer">
        <div class="product-device">
          <div class="device-reflection"></div>
          {screens.map((screen, index) => (
            <div
              class:list={["product-screen", { "is-active": index === 0 }]}
              data-product-screen={index}
            >
              <ManageDemo view={screen.view} />
            </div>
          ))}
        </div>
        <div class="product-caption">
          <span>StayKeep Manage · Example property</span>
          <div class="product-dots">
            {screens.map((_, index) => (
              <span
                class:list={[{ "is-active": index === 0 }]}
                data-product-dot={index}
              ></span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .product-story {
    padding: 6.5rem 0 4rem;
    background: #fff;
  }
  .product-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  .product-heading .eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    color: #677084;
  }
  .product-heading h2 {
    font-size: clamp(2.6rem, 5.2vw, 5.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }
  .product-heading > p {
    font-size: 0.875rem;
    line-height: 1.75;
    color: #687184;
    padding-bottom: 0.4rem;
  }
  .product-walkthrough {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 4rem;
    align-items: start;
  }
  .product-chapter {
    padding-block: 3rem;
  }
  .chapter-index {
    color: var(--color-primary);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 1.4rem;
  }
  .chapter-index > span {
    color: #798193;
    margin-left: 0.75rem;
  }
  .chapter-copy h3 {
    font-size: clamp(2rem, 3.2vw, 3.4rem);
    line-height: 1.14;
    letter-spacing: -0.05em;
    font-weight: 600;
  }
  .chapter-copy h3 > span {
    display: block;
  }
  .chapter-copy > p {
    font-size: 0.9rem;
    line-height: 1.8;
    color: #697185;
    margin-top: 1.3rem;
    max-width: 26rem;
  }
  .chapter-detail {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.8rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: #667083;
  }
  .chapter-detail :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-primary);
  }
  .chapter-copy .text-link {
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }
  .chapter-copy .text-link :global(.icon) {
    width: 1rem;
  }
  .chapter-mobile-screen {
    margin-top: 2rem;
  }
  .product-viewer {
    display: none;
  }
  .product-device {
    position: relative;
    border-radius: 16px;
    transform-style: preserve-3d;
    background: #eef1f7;
    border: 7px solid #e6e9ef;
    box-shadow:
      0 35px 70px #2a3c5618,
      0 5px 10px #2a3c5610;
  }
  .device-reflection {
    position: absolute;
    inset: -40px;
    z-index: -1;
    background: radial-gradient(ellipse, #eaf0ff, transparent 68%);
  }
  .product-screen {
    grid-area: 1/1;
    min-width: 0;
  }
  .product-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.3rem 0.5rem 0;
    font-size: 0.6rem;
    color: #8790a1;
  }
  .product-dots {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .product-dots span {
    width: 5px;
    height: 5px;
    border-radius: 10px;
    background: #d3dbea;
    transition:
      width 0.45s,
      background 0.45s;
  }
  .product-dots span.is-active {
    width: 23px;
    background: var(--color-primary);
  }
  @media (min-width: 901px) and (min-height: 550px) {
    :global(.motion-enabled) .product-chapter {
      min-height: 78svh;
      display: flex;
      align-items: center;
      padding-block: 4rem;
    }
    :global(.motion-enabled) .chapter-mobile-screen {
      display: none;
    }
    :global(.motion-enabled) .product-viewer {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      padding-top: 0;
      perspective: 1200px;
    }
    :global(.motion-enabled) .product-device {
      display: grid;
      transform: rotateY(calc(-9deg * (1 - var(--device-open, 0))))
        rotateX(calc(5deg * (1 - var(--device-open, 0))))
        scale(calc(0.95 + 0.05 * var(--device-open, 0)));
    }
    :global(.motion-enabled) .product-screen {
      opacity: 0;
      transform: translate3d(0, 24px, 0) scale(0.985);
      transition:
        opacity 0.55s ease,
        transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      visibility: hidden;
    }
    :global(.motion-enabled) .product-screen.is-active {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
      z-index: 1;
      pointer-events: auto;
      visibility: visible;
    }
    :global(.motion-enabled) .chapter-copy {
      opacity: 0.22;
      transition: opacity 0.5s;
    }
    :global(.motion-enabled) .product-chapter.is-active .chapter-copy,
    :global(.motion-enabled) .product-chapter:focus-within .chapter-copy {
      opacity: 1;
    }
  }
  @media (max-width: 1100px) {
    .product-walkthrough {
      gap: 2rem;
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  @media (min-width: 901px) and (max-height: 800px) {
    :global(.motion-enabled) .product-viewer {
      top: calc(var(--header-height) + 1rem);
    }
    .product-caption {
      padding-top: 0.75rem;
    }
  }
  @media (max-width: 900px) {
    .product-story {
      padding-block: 4rem;
    }
    .product-heading {
      display: block;
      margin-bottom: 0.5rem;
    }
    .product-heading > p {
      margin-top: 1.3rem;
    }
    .product-walkthrough {
      display: block;
    }
    .product-chapter {
      padding-block: 3rem;
      border-bottom: 1px solid #e6eaf1;
    }
    .product-chapter:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
    .chapter-copy h3 {
      font-size: clamp(2rem, 6.5vw, 3rem);
    }
    .chapter-copy > p {
      max-width: 35rem;
    }
    .chapter-mobile-screen {
      padding: 0.6rem;
      background: #f3f5fa;
      border-radius: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce), (max-height: 549px) {
    .product-walkthrough {
      display: block;
    }
    .product-chapters {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .product-chapter {
      min-width: 0;
    }
    .product-viewer {
      display: none;
    }
  }
  @media (max-width: 700px) {
    .product-chapters {
      display: block;
    }
  }
  :global(html:not(.motion-enabled)) .product-walkthrough {
    display: block;
  }
  :global(html:not(.motion-enabled)) .product-chapters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  @media (max-width: 700px) {
    :global(html:not(.motion-enabled)) .product-chapters {
      display: block;
    }
  }
</style>
