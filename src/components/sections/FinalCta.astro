---
import Icon from '../Icon.astro';
import { APP_STAYS_URL, MANAGE_URL } from '../../content/site';

interface Props {
  variant?: 'home' | 'owners';
}

const { variant = 'home' } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="final-cta">
      <h2 class="display-2">
        {variant === 'home' ? 'Ready when you are.' : 'Keep 100% of every booking.'}
      </h2>
      <p class="lede final-cta-lede">
        {variant === 'home'
          ? "Whether you're booking a stay or running one, StayKeep takes no commission — ever."
          : 'Set up your property on Manage and start taking direct bookings, at 0% commission.'}
      </p>

      <div class="hero-actions">
        {variant === 'home' ? (
          <>
            <a href={APP_STAYS_URL} class="btn btn-primary" rel="noopener">
              Find a stay
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="/owners" class="btn btn-outline">List your property</a>
          </>
        ) : (
          <>
            <a href={MANAGE_URL} class="btn btn-primary" rel="noopener">
              Get started on Manage
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="/contact" class="btn btn-outline">Talk to us</a>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: linear-gradient(155deg, var(--color-primary-container) 0%, var(--color-surface-container-high) 100%);
    border-radius: var(--radius-curve);
    padding: var(--space-3xl) var(--space-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final-cta-lede {
    max-width: 34rem;
    margin-top: var(--space-sm);
  }

  .final-cta .hero-actions {
    justify-content: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 479px) {
    .final-cta .hero-actions {
      flex-direction: column;
    }
    .final-cta .hero-actions .btn {
      width: 100%;
    }
  }
</style>
