---
interface Props {
  showEyebrow?: boolean;
}
const steps = [
  {
    title: "Make yourself at home.",
    text: "Add your property, rooms, rates and photos in StayKeep Manage.",
  },
  {
    title: "Put your place out there.",
    text: "Set up your website or share a direct booking link with guests.",
  },
  {
    title: "Welcome your next guest.",
    text: "Receive bookings directly and manage the stay from check-in to check-out.",
  },
];
---

<section class="section" aria-labelledby="how-it-works-heading">
  <div class="container">
    <div class="steps-heading">
      <p class="eyebrow">Simple to get started</p>
      <h2 class="display-2" id="how-it-works-heading">
        From your property
        <br />
        to their next great stay.
      </h2>
    </div>
    <ol class="steps">
      {steps.map((step, i) => (
        <li>
          <span class="step-number">0{i + 1}</span>
          <h3 class="display-4">{step.title}</h3>
          <p class="body-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps-heading {
    margin-bottom: 3rem;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    list-style: none;
  }
  .steps > li {
    border-top: 1px solid var(--color-outline-variant);
    padding-top: 1.5rem;
  }
  .step-number {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    display: inline-flex;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: #edf2ff;
    margin-bottom: 1.5rem;
  }
  .steps h3 {
    margin-bottom: 0.85rem;
  }
  .steps p {
    font-size: 0.9375rem;
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .step-number {
      margin-bottom: 1rem;
    }
    .steps-heading {
      margin-bottom: 2rem;
    }
  }
</style>
