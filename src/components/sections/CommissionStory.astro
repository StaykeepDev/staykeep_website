---
import { Image } from "astro:assets";
import logo from "../../assets/brand/booking-app-logo-hq.png";
import Icon from "../Icon.astro";
---

<section
  class="commission-story"
  data-scroll-scene="commission"
  aria-labelledby="commission-heading"
>
  <div class="commission-pin">
    <div class="container">
      <div class="commission-heading">
        <p class="eyebrow">One stay. A better deal for both.</p>
        <h2 id="commission-heading">
          <span>Guests pay less.</span> <span>Hosts keep more.</span>
        </h2>
        <p>The same ₹5,000 stay. See both sides of the booking.</p>
      </div>
      <div class="receipt-stage">
        <div class="zero-backdrop" aria-hidden="true">
          0<span>%</span>
        </div>
        <article
          class="receipt receipt-other"
          aria-label="Illustrative platform with a 15% guest fee and 15% host commission"
        >
          <div class="receipt-brand">
            <span class="other-mark" aria-hidden="true">
              ↗
            </span>
            <div>
              <strong>Example platform</strong>
              <span>Illustrative fees: 15% + 15%*</span>
            </div>
          </div>
          <div class="receipt-audience">
            <span class="audience-label">Guest pays</span>
            <strong class="audience-total">₹5,750</strong>
            <p class="audience-fee">
              ₹5,000 <span>+ ₹750 guest fee (15%)</span>
            </p>
          </div>
          <div class="receipt-audience">
            <span class="audience-label">Host receives</span>
            <strong class="audience-total">₹4,250</strong>
            <p class="audience-fee">
              ₹5,000 <span>− ₹750 commission (15%)</span>
            </p>
          </div>
        </article>
        <article
          class="receipt receipt-keep"
          aria-label="StayKeep with no guest booking fee and no host commission"
        >
          <div class="receipt-brand">
            <Image
              src={logo}
              alt=""
              width={34}
              height={34}
              widths={[68, 102]}
              sizes="34px"
              quality={100}
            />
            <div>
              <strong>StayKeep</strong>
              <span>0% for guests. 0% for hosts.</span>
            </div>
            <span class="receipt-check">
              <Icon name="check" />
            </span>
          </div>
          <div class="receipt-audience">
            <span class="audience-label">Guest pays</span>
            <strong class="audience-total">₹5,000</strong>
            <p class="audience-fee">
              ₹5,000 <span>+ ₹0 booking fee (0%)</span>
            </p>
          </div>
          <div class="receipt-audience">
            <span class="audience-label">Host receives</span>
            <strong class="audience-total">₹5,000</strong>
            <p class="audience-fee">
              ₹5,000 <span>− ₹0 commission (0%)</span>
            </p>
          </div>
        </article>
      </div>
      <div class="commission-ending">
        <div class="both-benefit" aria-label="Savings in this illustration">
          <div class="guest-benefit">
            <span>For the guest</span>
            <strong>₹750 less to pay</strong>
          </div>
          <span class="benefit-plus" aria-hidden="true">
            +
          </span>
          <div class="host-benefit">
            <span>For the host</span>
            <strong>₹750 more to keep</strong>
          </div>
        </div>
        <a href="#calculator" class="text-link">
          Calculate your host savings <Icon name="arrow-right" />
        </a>
      </div>
      <p class="commission-note">
        *Illustration assumes a 15% guest fee and a separate 15% host commission
        on the same ₹5,000 base price. Actual platform rates and fee structures
        vary; both fees do not apply everywhere. Taxes, payment charges and any
        StayKeep plan cost are excluded.
      </p>
      <div class="scene-track" aria-hidden="true">
        <span></span>
      </div>
    </div>
  </div>
</section>
<style>
  .commission-story {
    position: relative;
    background: #f5f7fb;
    padding-block: 5rem;
    overflow: clip;
  }
  .commission-pin {
    display: flex;
    align-items: center;
  }
  .commission-pin > .container {
    position: relative;
  }
  .commission-heading {
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .commission-heading .eyebrow {
    color: #677084;
    font-size: 0.65rem;
    letter-spacing: 0.13em;
    margin-bottom: 0.8rem;
  }
  .commission-heading h2 {
    font-size: clamp(2.5rem, 4.3vw, 4.1rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 1.1;
  }
  .commission-heading > p:last-child {
    font-size: 0.9rem;
    color: #697185;
    margin-top: 1rem;
  }
  .receipt-stage {
    height: 365px;
    position: relative;
    max-width: 780px;
    margin: 2.2rem auto 0;
    perspective: 1000px;
  }
  .zero-backdrop {
    display: none;
    position: absolute;
    inset: -60px -10% 0;
    text-align: center;
    font-size: 390px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.09em;
    color: #dce5ff;
    white-space: nowrap;
  }
  .zero-backdrop span {
    font-size: 0.7em;
  }
  .receipt {
    position: absolute;
    top: 0;
    left: 50%;
    width: 300px;
    margin-left: -150px;
    padding: 1.5rem;
    border-radius: 20px;
    border: 1px solid #dce1ea;
    background: white;
    box-shadow: 0 16px 44px #1c305410;
  }
  .receipt-other {
    transform: translate3d(-172px, 8px, 0) rotate(-6deg);
    color: #717887;
  }
  .receipt-keep {
    transform: translate3d(172px, 8px, 0) rotate(6deg);
    border-color: #c4d2f5;
    box-shadow: 0 22px 70px #3158b51a;
  }
  .receipt-brand {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 1.4rem;
  }
  .receipt-brand img {
    clip-path: inset(1.4% round 24%);
    border-radius: 9px;
    width: 34px;
    height: 34px;
  }
  .receipt-brand > div {
    flex: 1;
  }
  .receipt-brand strong {
    display: block;
    font-size: 0.875rem;
    color: #333d50;
  }
  .receipt-brand > div > span {
    display: block;
    font-size: 0.6rem;
    margin-top: 0.2rem;
    color: #7a8190;
  }
  .other-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: #edf0f5;
    color: #838b9a;
    font-size: 1.5rem;
  }
  .receipt-check {
    display: grid;
    place-items: center;
    width: 23px;
    height: 23px;
    background: #ebf0ff;
    border-radius: 50%;
    color: var(--color-primary);
  }
  .receipt-check :global(.icon) {
    width: 13px;
    height: 13px;
  }
  .receipt-audience {
    padding-block: 0.8rem;
  }
  .receipt-audience + .receipt-audience {
    border-top: 1px dashed #d7dce6;
  }
  .audience-label {
    display: block;
    font-size: 0.7rem;
    color: #616c7f;
  }
  .audience-total {
    display: block;
    font-size: 2.1rem;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.25;
    margin-top: 0.18rem;
    font-variant-numeric: tabular-nums;
  }
  .receipt-keep .audience-total {
    color: var(--color-primary);
  }
  .audience-fee {
    font-size: 0.6rem;
    color: #7a8190;
    margin-top: 0.3rem;
    line-height: 1.5;
  }
  .audience-fee span {
    color: #aa5e4b;
  }
  .receipt-keep .audience-fee span {
    color: var(--color-primary);
  }
  .commission-ending {
    text-align: center;
    position: relative;
    z-index: 2;
    margin-top: 0.4rem;
  }
  .both-benefit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.3rem;
  }
  .both-benefit > div {
    text-align: left;
  }
  .both-benefit > div > span {
    display: block;
    font-size: 0.65rem;
    color: #727c90;
    margin-bottom: 0.12rem;
  }
  .both-benefit strong {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .guest-benefit strong {
    color: #72511a;
    background: #faebc8;
    padding: 0.15rem 0.4rem;
    margin-left: -0.4rem;
    border-radius: 5px;
  }
  .host-benefit strong {
    color: var(--color-primary);
  }
  .benefit-plus {
    color: #b5becf;
    font-size: 1.15rem;
  }
  .commission-ending .text-link {
    font-size: 0.78rem;
    margin-top: 0.3rem;
  }
  .commission-ending :global(.icon) {
    width: 1rem;
  }
  .commission-note {
    max-width: 780px;
    margin: 1rem auto 0;
    text-align: center;
    font-size: 0.6rem;
    line-height: 1.65;
    color: #747d8f;
  }
  .scene-track {
    display: none;
    width: 70px;
    height: 2px;
    background: #dbe1ec;
    margin: 1.3rem auto 0;
    overflow: hidden;
  }
  .scene-track span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-primary);
    transform-origin: left;
    transform: scaleX(var(--scene-progress, 0));
  }
  :global(.motion-enabled) .commission-story {
    height: 205svh;
    padding-block: 0;
    overflow: visible;
  }
  :global(.motion-enabled) .commission-pin {
    position: sticky;
    top: var(--header-height);
    height: calc(100svh - var(--header-height));
    overflow: clip;
  }
  :global(.motion-enabled) .zero-backdrop {
    display: block;
    opacity: var(--keep, 0);
    transform: scale(calc(0.68 + 0.32 * var(--keep, 0)));
  }
  :global(.motion-enabled) .receipt-other {
    transform: translate3d(
        calc(-172px - 210px * var(--keep, 0)),
        calc(8px + 30px * var(--keep, 0)),
        0
      )
      rotate(calc(-6deg - 15deg * var(--keep, 0)));
    opacity: calc(1 - var(--keep, 0));
  }
  :global(.motion-enabled) .receipt-keep {
    transform: translate3d(
        calc(172px * (1 - var(--keep, 0))),
        calc(8px - 8px * var(--keep, 0)),
        0
      )
      rotate(calc(6deg * (1 - var(--keep, 0))))
      scale(calc(1 + 0.04 * var(--keep, 0)));
  }
  :global(.motion-enabled) .scene-track {
    display: block;
  }
  @media (min-width: 900px) and (min-height: 850px) {
    .commission-heading h2 {
      font-size: 4.1rem;
    }
    .receipt-stage {
      margin-top: 2.5rem;
      height: 390px;
    }
    .receipt {
      width: 340px;
      margin-left: -170px;
      padding: 1.75rem;
    }
    .receipt-brand {
      margin-bottom: 1rem;
    }
    .audience-total {
      font-size: 2.35rem;
    }
    .audience-label {
      font-size: 0.8rem;
    }
    .audience-fee {
      font-size: 0.68rem;
    }
  }
  @media (max-width: 760px) {
    .commission-story {
      padding-block: 4rem;
    }
    .commission-heading h2 {
      font-size: clamp(1.8rem, 7.8vw, 3.3rem);
    }
    .commission-heading h2 > span {
      display: block;
    }
    .commission-heading .eyebrow {
      font-size: 0.53rem;
    }
    .commission-heading > p:last-child {
      font-size: 0.75rem;
      max-width: 250px;
      margin-inline: auto;
    }
    .receipt-stage {
      height: 390px;
      max-width: 440px;
      margin-top: 2rem;
    }
    .receipt {
      width: calc(50% - 8px);
      margin-left: 0;
      padding: 1rem 0.8rem;
      border-radius: 14px;
    }
    .receipt-other {
      left: 0;
      transform: rotate(-4deg);
    }
    .receipt-keep {
      left: calc(50% + 8px);
      transform: rotate(4deg);
    }
    .receipt-brand {
      display: block;
      margin-bottom: 0.85rem;
    }
    .receipt-brand img,
    .other-mark {
      width: 27px;
      height: 27px;
      margin-bottom: 0.6rem;
    }
    .receipt-brand strong {
      font-size: 0.73rem;
    }
    .receipt-brand > div > span {
      font-size: 0.5rem;
      line-height: 1.5;
      min-height: 1.5em;
    }
    .receipt-check {
      display: none;
    }
    .receipt-audience {
      padding-block: 0.75rem;
    }
    .audience-label {
      font-size: 0.65rem;
    }
    .audience-total {
      font-size: 1.65rem;
      margin-top: 0.25rem;
    }
    .audience-fee {
      font-size: 0.55rem;
      line-height: 1.6;
    }
    .audience-fee span {
      display: block;
      min-height: 3.2em;
    }
    .zero-backdrop {
      font-size: 240px;
      top: 30px;
    }
    .both-benefit {
      gap: 1rem;
    }
    .both-benefit > div > span {
      font-size: 0.6rem;
    }
    .both-benefit strong {
      font-size: 0.8rem;
    }
    .commission-note {
      font-size: 0.55rem;
      max-width: 300px;
    }
    :global(.motion-enabled) .commission-story {
      height: 175svh;
    }
    :global(.motion-enabled) .receipt-stage {
      height: 390px;
    }
    :global(.motion-enabled) .receipt-other {
      transform: translate3d(
          calc(-120px * var(--keep, 0)),
          calc(-20px * var(--keep, 0)),
          0
        )
        rotate(calc(-4deg - 14deg * var(--keep, 0)));
    }
    :global(.motion-enabled) .receipt-keep {
      transform: translate3d(
          calc(-50% * var(--keep, 0) - 8px * var(--keep, 0)),
          0,
          0
        )
        rotate(calc(4deg * (1 - var(--keep, 0))))
        scale(calc(1 + 0.08 * var(--keep, 0)));
    }
  }
  @media (max-width: 760px) and (max-height: 790px) {
    :global(.motion-enabled) .commission-story {
      height: auto;
      padding-block: 3rem;
      overflow: clip;
    }
    :global(.motion-enabled) .commission-pin {
      position: static;
      height: auto;
    }
    :global(.motion-enabled) .receipt-other {
      transform: rotate(-4deg);
      opacity: 1;
    }
    :global(.motion-enabled) .receipt-keep {
      transform: rotate(4deg);
    }
    :global(.motion-enabled) .zero-backdrop,
    :global(.motion-enabled) .scene-track {
      display: none;
    }
  }
  @media (max-height: 800px) and (min-width: 761px) {
    .commission-heading h2 {
      font-size: 2.6rem;
    }
    .commission-heading .eyebrow {
      margin-bottom: 0.4rem;
    }
    .commission-heading > p:last-child {
      margin-top: 0.4rem;
    }
    .receipt-stage {
      margin-top: 1rem;
      height: 310px;
    }
    .receipt {
      padding: 1.1rem;
    }
    .receipt-brand {
      margin-bottom: 0.65rem;
    }
    .receipt-audience {
      padding-block: 0.5rem;
    }
    .audience-total {
      font-size: 1.75rem;
    }
    .scene-track {
      margin-top: 0.5rem;
    }
    .commission-note {
      margin-top: 0.4rem;
    }
    .both-benefit strong {
      font-size: 0.85rem;
    }
  }
  @media (max-width: 360px) {
    .receipt {
      padding: 0.85rem 0.65rem;
    }
    .receipt-brand strong {
      font-size: 0.65rem;
    }
    .receipt-brand > div > span {
      min-height: 3em;
    }
    .audience-total {
      font-size: 1.4rem;
    }
    .audience-label {
      font-size: 0.6rem;
    }
    .both-benefit {
      gap: 0.65rem;
    }
    .both-benefit strong {
      font-size: 0.68rem;
    }
    .benefit-plus {
      font-size: 0.85rem;
    }
  }
  @media (prefers-reduced-motion: reduce), (max-height: 600px) {
    .commission-story {
      height: auto !important;
      padding-block: 4rem !important;
    }
    .commission-pin {
      position: static !important;
      height: auto !important;
    }
  }
</style>
