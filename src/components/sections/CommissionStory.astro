---
import { Image } from "astro:assets";
import logo from "../../assets/brand/booking-app-logo-hq.png";
import Icon from "../Icon.astro";

const sides = [
  {
    key: "other",
    name: "Example platform",
    note: "Illustrative fees: 15% guest fee + 15% commission*",
    label:
      "Illustrative platform with a 15% guest fee and a 15% host commission",
    rows: [
      {
        title: "Guest pays",
        total: "₹5,750",
        base: "₹5,000",
        fee: "+ ₹750 guest fee (15%)",
      },
      {
        title: "Host receives",
        total: "₹4,250",
        base: "₹5,000",
        fee: "- ₹750 commission (15%)",
      },
    ],
  },
  {
    key: "keep",
    name: "StayKeep",
    note: "0% for guests. 0% for hosts.",
    label: "StayKeep with no guest booking fee and no host commission",
    rows: [
      {
        title: "Guest pays",
        total: "₹5,000",
        base: "₹5,000",
        fee: "+ ₹0 booking fee (0%)",
      },
      {
        title: "Host receives",
        total: "₹5,000",
        base: "₹5,000",
        fee: "- ₹0 commission (0%)",
      },
    ],
  },
] as const;
---

<section
  class="section commission-story"
  id="commission"
  aria-labelledby="commission-heading"
>
  <div class="container">
    <div class="section-heading section-heading-center commission-heading">
      <p class="eyebrow">One stay. A better deal for both.</p>
      <h2 class="display-2" id="commission-heading">
        Guests pay less. Hosts keep more.
      </h2>
      <p class="lede">The same ₹5,000 stay, seen from both sides.</p>
    </div>

    <div class="receipts" data-reveal>
      {
        sides.map((side) => (
          <article class={`receipt receipt-${side.key}`} aria-label={side.label}>
            <header class="receipt-brand">
              {side.key === "keep" ? (
                <Image
                  src={logo}
                  alt=""
                  width={40}
                  height={40}
                  widths={[80, 120]}
                  sizes="40px"
                  quality={100}
                />
              ) : (
                <span class="other-mark" aria-hidden="true">
                  <Icon name="globe" />
                </span>
              )}
              <div class="receipt-brand-text">
                <strong>{side.name}</strong>
                <span>{side.note}</span>
              </div>
              {side.key === "keep" && (
                <span class="receipt-badge">
                  <Icon name="check" />
                  No fees
                </span>
              )}
            </header>
            <dl class="receipt-rows">
              {side.rows.map((row) => (
                <div class="receipt-row">
                  <dt>{row.title}</dt>
                  <dd>
                    <strong class="sk-tabular">{row.total}</strong>
                    <span>
                      {row.base} <em>{row.fee}</em>
                    </span>
                  </dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>

    <div class="commission-ending" data-reveal>
      <ul class="both-benefit" aria-label="Savings in this illustration">
        <li class="guest-benefit">
          <span>For the guest</span>
          <strong>₹750 less to pay</strong>
        </li>
        <li class="host-benefit">
          <span>For the host</span>
          <strong>₹750 more to keep</strong>
        </li>
      </ul>
      <a href="#calculator" class="text-link">
        Calculate your host savings <Icon name="arrow-right" />
      </a>
    </div>

    <p class="fee-footnote commission-note">
      *Illustration assumes a 15% guest fee and a separate 15% host commission
      on the same ₹5,000 base price. Actual platform rates and fee structures
      vary, and both fees do not apply everywhere. Taxes, payment charges and
      any StayKeep plan cost are excluded.
    </p>
  </div>
</section>

<style>
  .commission-story {
    background: var(--color-surface-container);
    border-block: 1px solid var(--color-outline-variant);
  }
  .commission-heading {
    max-width: 40rem;
  }
  .commission-heading .lede {
    margin-top: 1rem;
  }
  .receipts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    max-width: 920px;
    margin-inline: auto;
  }
  .receipt {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: var(--color-surface-lowest);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-card);
  }
  .receipt-keep {
    border-color: #b9c9f3;
    box-shadow: 0 18px 50px #315ed214;
  }
  .receipt-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .receipt-brand img,
  .other-mark {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 11px;
  }
  .receipt-brand img {
    clip-path: inset(1.4% round 24%);
  }
  .other-mark {
    display: grid;
    place-items: center;
    background: var(--color-surface-container);
    color: var(--color-on-surface-variant);
  }
  .other-mark :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .receipt-brand-text {
    flex: 1;
    min-width: 0;
  }
  .receipt-brand-text strong {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .receipt-brand-text span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-on-surface-variant);
  }
  .receipt-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.3rem 0.65rem;
    border-radius: 100px;
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .receipt-badge :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
    stroke-width: 2.2;
  }
  .receipt-rows {
    display: grid;
  }
  .receipt-row {
    padding-block: 1.2rem;
  }
  .receipt-row + .receipt-row {
    border-top: 1px dashed var(--color-outline-variant);
  }
  .receipt-row:last-child {
    padding-bottom: 0.25rem;
  }
  .receipt-row dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
  }
  .receipt-row dd {
    margin: 0.35rem 0 0;
  }
  .receipt-row dd strong {
    display: block;
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: var(--color-on-surface);
  }
  .receipt-other .receipt-row dd strong {
    color: #4a5569;
  }
  .receipt-keep .receipt-row dd strong {
    color: var(--color-primary);
  }
  .receipt-row dd span {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }
  .receipt-row dd em {
    font-style: normal;
    font-weight: 600;
    color: #a4512f;
  }
  .receipt-keep .receipt-row dd em {
    color: var(--color-primary);
  }
  .commission-ending {
    text-align: center;
    margin-top: 2rem;
  }
  .both-benefit {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .both-benefit li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 0.75rem 1.25rem;
    border-radius: 14px;
    text-align: left;
    min-width: 13.5rem;
  }
  .both-benefit li span {
    font-size: 0.8125rem;
  }
  .both-benefit li strong {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .guest-benefit {
    background: #fbefd1;
    color: #6b4a12;
  }
  .host-benefit {
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }
  .commission-ending .text-link {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .commission-ending .text-link :global(.icon) {
    width: 1.1rem;
  }
  .commission-note {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    margin-top: 2rem;
    font-size: 0.75rem;
  }
  @media (max-width: 760px) {
    .receipts {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .receipt {
      padding: 1.35rem;
    }
    .receipt-row {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: 0.2rem 1rem;
      padding-block: 1rem;
    }
    .receipt-row dt {
      white-space: nowrap;
    }
    .receipt-row dd {
      display: contents;
    }
    .receipt-row dd strong {
      grid-column: 2;
      grid-row: 1;
      font-size: 1.75rem;
      text-align: right;
    }
    .receipt-row dd span {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 0;
      text-align: right;
    }
    .both-benefit {
      flex-direction: column;
      align-items: stretch;
    }
    .both-benefit li {
      min-width: 0;
    }
  }
</style>
