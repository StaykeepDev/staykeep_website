---
import Icon from '../Icon.astro';
import BrowserFrame from '../BrowserFrame.astro';
import websitePreviewImg from '../../assets/screenshots/website-preview.png';
import websitePreviewPhoneImg from '../../assets/screenshots/website-preview-phone.png';
import websiteBuilderImg from '../../assets/screenshots/website-builder.png';
import websiteBuilderMobileImg from '../../assets/screenshots/website-builder-mobile.png';

const points = [
  'Drag-and-drop sections, your own photos and videos',
  'Rooms with full details, and places to visit nearby',
  'A blog, and your own colours',
  'A booking widget — bookings come straight to you, at 0% commission',
];
---

<section class="section" aria-labelledby="own-website-detailed-heading">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Free to set up</p>
      <h2 class="display-2" id="own-website-detailed-heading">Your own website</h2>
      <p class="lede">
        Every StayKeep owner can set up a website at <strong>yourname.staykeep.com</strong> — no
        separate developer, no separate fee.
      </p>
    </div>

    <div class="own-website-shots">
      <figure class="own-website-shot own-website-shot-primary">
        <BrowserFrame
          src={websitePreviewImg}
          mobileSrc={websitePreviewPhoneImg}
          alt="The StayKeep website builder's drag-and-drop editor, with a live phone preview of Lakeview Homestay's site: a teal hero section, the property name and location, and a Check availability button"
          url="yourname.staykeep.com/edit"
          widths={[480, 768, 1024]}
          sizes="(min-width: 900px) 60vw, 92vw"
        />
        <figcaption class="body-text">Build your site with drag-and-drop sections — see the result live as you go.</figcaption>
      </figure>
      <figure class="own-website-shot">
        <BrowserFrame
          src={websiteBuilderImg}
          mobileSrc={websiteBuilderMobileImg}
          alt="StayKeep Manage showing a published website for Lakeview Homestay at lakeview-homestay.staykeep.com, marked LIVE"
          url="manage.staykeep.com"
          widths={[480, 768]}
          sizes="(min-width: 900px) 38vw, 92vw"
        />
        <figcaption class="body-text">Publish it, and it's live at your own StayKeep address.</figcaption>
      </figure>
    </div>

    <ul class="own-website-list-lg">
      {points.map((point) => (
        <li class="card">
          <Icon name="check" size={20} class="check-yes" />
          <span class="body-text">{point}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .own-website-shots {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-2xl);
  }

  .own-website-shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .own-website-shot figcaption {
    color: var(--color-on-surface-variant);
  }

  .own-website-list-lg {
    list-style: none;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  .own-website-list-lg li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  @media (min-width: 700px) {
    .own-website-list-lg {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .own-website-shots {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }
  }
</style>
