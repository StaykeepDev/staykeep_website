---
import { Image } from "astro:assets";
import { APP_STAYS_URL } from "../../content/site";
import Icon from "../Icon.astro";
import stayImage from "../../assets/photos/tropical-stay.jpg";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-intro">
    <p class="eyebrow hero-enter">
      <span aria-hidden="true"></span>Book direct. Keep more.
    </p>
    <h1 id="hero-heading">
      <span class="headline-line">
        <span>More stay.</span>
      </span>
      <span class="commission-offer">
        <span class="commission-number">
          <span>
            0<span class="percent-sign">%</span>
          </span>
        </span>
        <span class="commission-label">
          booking
          <br />
          commission.
        </span>
      </span>
    </h1>
    <p class="hero-lede hero-enter">
      Guests pay less. Hosts keep more.
      <br />
      No guest booking fee. No host commission.
    </p>
    <div class="actions hero-enter">
      <a href={APP_STAYS_URL} class="btn btn-primary">
        Find a stay <Icon name="arrow-right" />
      </a>
      <a href="/owners" class="btn btn-outline">
        List your property <Icon name="arrow-right" />
      </a>
    </div>
    <div
      class="hero-comparison hero-enter"
      aria-label="Booking commission at a glance"
    >
      <div class="other-platforms">
        <span>Other platforms</span>
        <strong>Commission may apply</strong>
      </div>
      <span class="comparison-arrow" aria-hidden="true">
        →
      </span>
      <div class="staykeep-promise">
        <span>With StayKeep</span>
        <strong>
          <Icon name="check" />
          0% on every booking
        </strong>
      </div>
    </div>
    <a href="#stay-experience" class="scroll-cue">
      <span>A little closer to your next escape</span>
      <span class="scroll-arrow" aria-hidden="true">
        ↓
      </span>
    </a>
  </div>
</section>

<section
  class="stay-experience"
  id="stay-experience"
  data-scroll-scene="escape"
  aria-labelledby="escape-heading"
>
  <div class="escape-pin">
    <div class="escape-window">
      <Image
        src={stayImage}
        alt="A sunlit tropical villa with a private pool and open-air lounge"
        widths={[768, 1200, 1800]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="escape-photo"
      />
      <div class="escape-shade"></div>
      <div class="escape-topline">
        <span>A little closer to your next escape.</span>
        <span>STAYKEEP / BOOK DIRECT</span>
      </div>
      <div class="escape-copy">
        <p class="escape-eyebrow">The places you’ll remember.</p>
        <h2 id="escape-heading">
          All the feeling.
          <br />
          Book it directly.
        </h2>
        <p>
          Find a homestay or hotel. Meet your host.
          <br />
          Make yourself at home.
        </p>
      </div>
      <div class="escape-seal">
        <span>BOOK DIRECT</span>
        <strong>
          0<span>%</span>
        </strong>
        <span>BOOKING COMMISSION</span>
      </div>
      <div class="escape-bottomline">
        <span>For the getaway. And the people who make it.</span>
        <span class="escape-progress" aria-hidden="true">
          <i></i>
        </span>
      </div>
    </div>
  </div>
</section>

<div class="container">
  <div class="search-strip" data-reveal>
    <div>
      <strong>Your next stay starts here.</strong>
      <span>Homestays & hotels. Booked directly.</span>
    </div>
    <form action={APP_STAYS_URL} method="get" role="search">
      <Icon name="map-pin" />
      <label for="hero-search-q" class="visually-hidden">
        Where do you want to stay?
      </label>
      <input
        id="hero-search-q"
        name="q"
        type="search"
        placeholder="Where do you want to stay?"
        autocomplete="off"
      />
      <button type="submit" aria-label="Search stays">
        <Icon name="arrow-right" />
      </button>
    </form>
    <a href="/owners">
      Have a place to share?
      <span>
        Become a host <Icon name="arrow-right" />
      </span>
    </a>
  </div>
</div>

<style>
  .hero {
    background: linear-gradient(180deg, #fffdf9 0%, #fffdf9 68%, #fafbfe 100%);
    text-align: center;
    padding: clamp(3rem, 6vh, 4.5rem) 0 1.5rem;
    color: #262b35;
  }
  .hero-intro {
    position: relative;
  }
  .hero .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: #77684f;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    margin-bottom: 1.3rem;
  }
  .hero .eyebrow > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d69a3d;
  }
  .hero h1 {
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }
  .headline-line {
    display: block;
    overflow: clip;
    padding-bottom: 0.13em;
    margin-bottom: 0.22rem;
    font-size: clamp(2.8rem, 4.7vw, 4.4rem);
  }
  .headline-line > span {
    display: block;
  }
  .commission-offer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.8rem;
    padding: 0.65rem 0.5rem;
  }
  .commission-number {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    padding: 0.04em 0.12em 0.1em;
    font-size: clamp(7rem, 10.2vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 1;
  }
  .commission-number::before {
    content: "";
    position: absolute;
    inset: 4% -2% 2%;
    z-index: -1;
    background: #f6d68e;
    border-radius: 20px;
    transform: rotate(-4deg);
  }
  .commission-number > span {
    display: block;
  }
  .percent-sign {
    font-size: 0.58em;
    letter-spacing: -0.06em;
    margin-left: 0.03em;
  }
  .commission-label {
    text-align: left;
    font-size: clamp(2.4rem, 4.1vw, 4rem);
    line-height: 1.13;
    letter-spacing: -0.055em;
  }
  .hero-lede {
    color: #74706a;
    font-size: 1rem;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }
  .hero .actions {
    justify-content: center;
    margin-top: 1.65rem;
  }
  .hero .btn {
    min-height: 52px;
    padding-inline: 1.7rem;
    font-size: 0.875rem;
  }
  .hero .btn-primary {
    background: #292e39;
    color: #fff;
    box-shadow: 0 5px 16px #292e3910;
  }
  .hero .btn-primary:hover {
    background: #111720;
  }
  .hero .btn-outline {
    border-color: #d8d6d0;
    background: #ffffffb3;
  }
  .hero .btn-outline:hover {
    background: #fff7e7;
  }
  .hero .btn :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .hero-comparison {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    margin: 1.8rem auto 0;
  }
  .hero-comparison > div {
    text-align: left;
  }
  .hero-comparison > div > span {
    display: block;
    font-size: 0.64rem;
    color: #817c73;
    margin-bottom: 0.2rem;
  }
  .hero-comparison strong {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #77736e;
  }
  .hero-comparison .staykeep-promise strong {
    color: #624615;
    font-weight: 600;
  }
  .staykeep-promise {
    position: relative;
  }
  .staykeep-promise strong {
    background: #f9e8bd;
    border-radius: 5px;
    padding: 0.18rem 0.4rem;
    margin-left: -0.4rem;
  }
  .staykeep-promise :global(.icon) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .comparison-arrow {
    color: #b4aca0;
    font-size: 1.1rem;
  }
  .scroll-cue {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    margin-top: 2.3rem;
    color: #85817b;
    font-size: 0.64rem;
    letter-spacing: 0.02em;
  }
  .scroll-arrow {
    border: 1px solid #e2ded6;
    border-radius: 50%;
    width: 27px;
    height: 27px;
    display: grid;
    place-items: center;
    font-size: 0.9rem;
  }
  .stay-experience {
    background: #fafbfe;
    position: relative;
  }
  .escape-pin {
    height: min(820px, calc(100svh - var(--header-height)));
    min-height: 520px;
  }
  .escape-window {
    position: relative;
    isolation: isolate;
    height: 100%;
    overflow: clip;
    clip-path: inset(2% 4% 2% 4% round 28px);
    background: #1c302b;
  }
  .escape-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .escape-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0a151e26, transparent 25%, #071321a6);
  }
  .escape-topline,
  .escape-bottomline {
    position: absolute;
    left: 7%;
    right: 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: white;
    font-size: 0.68rem;
    letter-spacing: 0.02em;
  }
  .escape-topline {
    top: 9%;
  }
  .escape-topline > span:last-child {
    letter-spacing: 0.12em;
    font-size: 0.6rem;
  }
  .escape-bottomline {
    bottom: 8%;
  }
  .escape-copy {
    position: absolute;
    left: 7%;
    bottom: 19%;
    color: white;
  }
  .escape-eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }
  .escape-copy h2 {
    font-size: clamp(2.8rem, 5.8vw, 6rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  .escape-copy > p:last-child {
    margin-top: 1.2rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #ffffffe6;
  }
  .escape-seal {
    position: absolute;
    right: 8%;
    bottom: 22%;
    width: 154px;
    height: 154px;
    border-radius: 50%;
    background: #fffffff2;
    color: #243b67;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    box-shadow: 0 15px 40px #00000014;
  }
  .escape-seal > span {
    font-size: 0.45rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }
  .escape-seal strong {
    font-size: 4.8rem;
    line-height: 1.17;
    letter-spacing: -0.075em;
    font-weight: 600;
  }
  .escape-seal strong span {
    font-size: 2.5rem;
  }
  .escape-progress {
    height: 2px;
    background: #ffffff40;
    width: 120px;
    overflow: hidden;
  }
  .escape-progress i {
    display: block;
    height: 100%;
    background: white;
    transform-origin: left;
    transform: scaleX(var(--scene-progress, 1));
  }
  :global(.motion-enabled) .stay-experience {
    height: 175svh;
  }
  :global(.motion-enabled) .escape-pin {
    position: sticky;
    top: var(--header-height);
    height: calc(100svh - var(--header-height));
    min-height: 0;
  }
  :global(.motion-enabled) .escape-window {
    clip-path: inset(
      calc(3% * (1 - var(--open, 0))) calc(8% * (1 - var(--open, 0)))
        calc(3% * (1 - var(--open, 0))) calc(8% * (1 - var(--open, 0))) round
        calc(32px * (1 - var(--open, 0)))
    );
  }
  :global(.motion-enabled) .escape-photo {
    transform: scale(calc(1.14 - 0.14 * var(--scene-progress, 0)));
  }
  :global(.motion-enabled) .escape-copy {
    transform: translate3d(0, calc(38px * (1 - var(--copy, 0))), 0);
    opacity: var(--copy, 0);
  }
  :global(.motion-enabled) .escape-seal {
    transform: translate3d(0, calc(70px * (1 - var(--copy, 0))), 0)
      rotate(calc(15deg * (1 - var(--copy, 0))));
    opacity: var(--copy, 0);
  }
  :global(.motion-enabled) .escape-topline,
  :global(.motion-enabled) .escape-bottomline {
    left: calc(7% + 5% * (1 - var(--open, 0)));
    right: calc(7% + 5% * (1 - var(--open, 0)));
  }
  .search-strip {
    display: grid;
    grid-template-columns: 1fr 1.2fr 0.8fr;
    gap: 2rem;
    align-items: center;
    padding: 2.2rem 0;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .search-strip > div strong {
    display: block;
    font-size: 0.875rem;
  }
  .search-strip > div > span {
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
  }
  .search-strip form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem;
    border: 1px solid #d7dfec;
    border-radius: 100px;
    background: white;
  }
  .search-strip form > .icon {
    width: 1.15rem;
    color: #657087;
  }
  .search-strip input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 0.8rem;
    padding: 0.5rem 0;
  }
  .search-strip button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border: 0;
    border-radius: 50%;
    color: white;
    background: var(--color-primary);
  }
  .search-strip button .icon {
    width: 1.1rem;
  }
  .search-strip > a {
    justify-self: end;
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
  }
  .search-strip > a span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-primary);
    font-weight: 600;
  }
  .search-strip > a .icon {
    width: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .headline-line > span {
      animation: headline-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .commission-number {
      animation: number-in 1.1s 0.08s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .commission-label {
      animation: intro-in 0.9s 0.18s both;
    }
    @keyframes number-in {
      from {
        opacity: 0;
        transform: translateY(22px) scale(0.92) rotate(3deg);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1) rotate(0);
      }
    }
    .hero-enter {
      animation: intro-in 0.9s 0.25s both;
    }
    .hero .actions {
      animation-delay: 0.35s;
    }
    .hero-comparison {
      animation-delay: 0.45s;
    }
    @keyframes headline-in {
      from {
        transform: translateY(115%) rotate(2deg);
      }
      to {
        transform: translateY(0) rotate(0);
      }
    }
    @keyframes intro-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  @media (min-width: 1600px) {
    .hero {
      padding-top: 4.5rem;
    }
  }
  @media (max-width: 860px) {
    .hero {
      padding-top: 3.5rem;
    }
    .search-strip {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
    .search-strip form {
      grid-column: 1/-1;
      grid-row: 2;
    }
    .escape-seal {
      width: 118px;
      height: 118px;
    }
    .escape-seal strong {
      font-size: 3.5rem;
    }
    .escape-seal strong span {
      font-size: 2rem;
    }
    .escape-seal > span {
      font-size: 0.35rem;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-top: 2.3rem;
      padding-bottom: 0.8rem;
    }
    .hero .eyebrow {
      font-size: 0.55rem;
      margin-bottom: 1.2rem;
    }
    .headline-line {
      font-size: 2.6rem;
      margin-bottom: 0.5rem;
    }
    .commission-offer {
      gap: 1rem;
      padding-block: 0.5rem;
    }
    .commission-number {
      font-size: clamp(5.6rem, 22vw, 7.5rem);
      padding: 0.04em 0.1em 0.1em;
    }
    .commission-number::before {
      border-radius: 13px;
    }
    .commission-label {
      font-size: clamp(1.65rem, 6.4vw, 2.4rem);
    }
    .hero-lede {
      font-size: 0.78rem;
      margin-top: 1.3rem;
      line-height: 1.8;
    }
    .hero .actions {
      gap: 0.65rem;
      margin-top: 1.35rem;
    }
    .hero .btn {
      font-size: 0.75rem;
      min-height: 48px;
      padding: 0.75rem 1.15rem;
      gap: 0.55rem;
    }
    .hero-comparison {
      gap: 0.8rem;
      margin-top: 1.5rem;
    }
    .hero-comparison > div > span {
      font-size: 0.58rem;
    }
    .hero-comparison strong {
      font-size: 0.62rem;
    }
    .comparison-arrow {
      font-size: 0.8rem;
    }
    .staykeep-promise :global(.icon) {
      width: 0.7rem;
      height: 0.7rem;
    }
    .scroll-cue {
      margin-top: 1.6rem;
      font-size: 0.57rem;
    }
    .escape-pin {
      min-height: 540px;
    }
    :global(.motion-enabled) .stay-experience {
      height: 140svh;
    }
    .escape-copy {
      bottom: 27%;
      left: 7%;
    }
    .escape-copy h2 {
      font-size: clamp(2.1rem, 9.5vw, 3.6rem);
    }
    .escape-copy > p:last-child {
      font-size: 0.75rem;
    }
    .escape-eyebrow {
      font-size: 0.55rem;
      margin-bottom: 1rem;
    }
    .escape-seal {
      width: 92px;
      height: 92px;
      bottom: 7%;
      right: 7%;
    }
    .escape-seal > span {
      font-size: 0.28rem;
    }
    .escape-seal strong {
      font-size: 2.8rem;
    }
    .escape-seal strong span {
      font-size: 1.6rem;
    }
    .escape-bottomline {
      max-width: 160px;
      font-size: 0.55rem;
      bottom: 10%;
    }
    .escape-progress,
    .escape-topline > span:last-child {
      display: none;
    }
    .escape-topline {
      font-size: 0.55rem;
      top: 8%;
    }
    .search-strip {
      padding-block: 1.5rem;
      column-gap: 0.75rem;
    }
    .search-strip > div strong {
      font-size: 0.75rem;
    }
    .search-strip > div > span,
    .search-strip > a {
      font-size: 0.65rem;
    }
    .search-strip > a span {
      font-size: 0.75rem;
    }
  }
  @media (max-width: 360px) {
    .headline-line {
      font-size: 2.3rem;
    }
    .commission-offer {
      gap: 0.65rem;
      padding-inline: 0;
    }
    .commission-number {
      font-size: 5rem;
    }
    .commission-label {
      font-size: 1.45rem;
    }
    .hero .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .hero .btn {
      padding: 0.7rem 0.5rem;
      font-size: 0.68rem;
      gap: 0.4rem;
    }
    .hero .btn {
      white-space: nowrap;
    }
    .hero .btn :global(.icon) {
      display: none;
    }
    .hero-comparison {
      gap: 0.6rem;
    }
    .hero-comparison strong {
      font-size: 0.57rem;
    }
    .hero-comparison > div > span {
      font-size: 0.55rem;
    }
    .staykeep-promise strong {
      padding: 0.18rem 0.3rem;
    }
  }
  @media (max-height: 560px) and (min-width: 700px) {
    .escape-copy h2 {
      font-size: 3rem;
    }
    .escape-copy > p:last-child,
    .escape-eyebrow {
      display: none;
    }
    .escape-seal {
      width: 110px;
      height: 110px;
    }
    .escape-seal strong {
      font-size: 3rem;
    }
  }
</style>
