---
import { Image } from "astro:assets";
import { APP_STAYS_URL } from "../../content/site";
import Icon from "../Icon.astro";
import stayImage from "../../assets/photos/tropical-stay.jpg";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-intro">
    <p class="eyebrow hero-enter">Book direct. Keep more.</p>
    <h1 id="hero-heading">
      <span class="headline-line">
        <span>More stay.</span>
      </span>
      <span class="commission-offer">
        <span class="commission-number">
          <span>
            0<span class="percent-sign">%</span>
          </span>
        </span>
        <span class="commission-label">
          booking
          <br />
          commission.
        </span>
      </span>
    </h1>
    <p class="hero-lede hero-enter">
      Guests pay less. Hosts keep more.
      <br />
      No guest booking fee. No host commission.
    </p>
    <div class="actions hero-enter">
      <a href={APP_STAYS_URL} class="btn btn-primary">
        Find a stay <Icon name="arrow-right" />
      </a>
      <a href="/owners" class="btn btn-outline">
        List your property <Icon name="arrow-right" />
      </a>
    </div>
    <a href="#stay-experience" class="scroll-cue hero-enter">
      <span>A little closer to your next escape</span>
      <span class="scroll-arrow" aria-hidden="true">
        ↓
      </span>
    </a>
  </div>
</section>

<section
  class="stay-experience"
  id="stay-experience"
  data-scroll-scene="escape"
  aria-labelledby="escape-heading"
>
  <div class="escape-pin">
    <div class="escape-window">
      <Image
        src={stayImage}
        alt="A sunlit tropical villa with a private pool and open-air lounge"
        widths={[768, 1200, 1800]}
        sizes="100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="escape-photo"
      />
      <div class="escape-shade"></div>
      <div class="escape-topline">
        <span>A little closer to your next escape.</span>
        <span>StayKeep / Book direct</span>
      </div>
      <div class="escape-copy">
        <p class="escape-eyebrow">The places you’ll remember.</p>
        <h2 id="escape-heading">
          All the feeling.
          <br />
          Book it directly.
        </h2>
        <p>
          Find a homestay or hotel. Meet your host.
          <br />
          Make yourself at home.
        </p>
      </div>
      <div
        class="escape-seal"
        role="img"
        aria-label="Book direct: 0% booking commission"
      >
        <svg class="seal-ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <path
              id="seal-ring-path"
              d="M100 100 m-70 0 a70 70 0 1 1 140 0 a70 70 0 1 1 -140 0"
            ></path>
          </defs>
          <g class="seal-ring-spin">
            <text class="seal-ring-text">
              <textPath href="#seal-ring-path">
                · BOOK DIRECT · NO BOOKING FEE · 0% COMMISSION
              </textPath>
            </text>
          </g>
          <text class="seal-zero" x="100" y="100" text-anchor="middle">
            0<tspan class="seal-pct">%</tspan>
          </text>
        </svg>
        <span class="seal-pill" aria-hidden="true">
          <strong>0%</strong>
          <span>Booking commission</span>
        </span>
      </div>
      <div class="escape-bottomline">
        <span>For the getaway. And the people who make it.</span>
        <span class="escape-progress" aria-hidden="true">
          <i></i>
        </span>
      </div>
    </div>
  </div>
</section>

<div class="container">
  <div class="search-strip" data-reveal>
    <div>
      <strong>Your next stay starts here.</strong>
      <span>Homestays & hotels. Booked directly.</span>
    </div>
    <form action={APP_STAYS_URL} method="get" role="search">
      <Icon name="map-pin" />
      <label for="hero-search-q" class="visually-hidden">
        Where do you want to stay?
      </label>
      <input
        id="hero-search-q"
        name="q"
        type="search"
        placeholder="Where do you want to stay?"
        autocomplete="off"
      />
      <button type="submit" aria-label="Search stays">
        <Icon name="arrow-right" />
      </button>
    </form>
    <a href="/owners">
      Have a place to share?
      <span>
        Become a host <Icon name="arrow-right" />
      </span>
    </a>
  </div>
</div>

<style>
  .hero {
    background: linear-gradient(#f5f7ff, #fff);
    text-align: center;
    padding: clamp(3rem, 6vh, 4.5rem) 0 1.5rem;
  }
  .hero-intro {
    position: relative;
  }
  .hero .eyebrow {
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }
  .headline-line {
    display: block;
    overflow: clip;
    padding-bottom: 0.13em;
    margin-bottom: 0.22rem;
    font-size: clamp(2.8rem, 4.7vw, 4.4rem);
  }
  .headline-line > span {
    display: block;
  }
  .commission-offer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.8rem;
    padding: 0.65rem 0.5rem;
  }
  .commission-number {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    padding: 0.04em 0.12em 0.1em;
    font-size: clamp(7rem, 10.2vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 1;
    color: var(--color-dark);
  }
  .commission-number::before {
    content: "";
    position: absolute;
    inset: 4% -2% 2%;
    z-index: -1;
    background: var(--color-accent);
    border-radius: 20px;
    transform: rotate(-4deg);
  }
  .commission-number > span {
    display: block;
  }
  .percent-sign {
    font-size: 0.58em;
    letter-spacing: -0.06em;
    margin-left: 0.03em;
  }
  .commission-label {
    text-align: left;
    font-size: clamp(2.4rem, 4.1vw, 4rem);
    line-height: 1.13;
    letter-spacing: -0.055em;
  }
  .hero-lede {
    color: var(--color-on-surface-variant);
    font-size: 1.0625rem;
    margin: 1.5rem auto 0;
    line-height: 1.7;
  }
  .hero .actions {
    justify-content: center;
    margin-top: 1.75rem;
  }
  .hero .btn {
    padding-inline: 1.7rem;
  }
  .hero .btn-outline {
    background: #ffffffb3;
  }
  .hero .btn :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .scroll-cue {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 2.5rem;
    color: var(--color-on-surface-variant);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .scroll-cue:hover {
    color: var(--color-primary);
  }
  .scroll-arrow {
    border: 1px solid var(--color-outline-variant);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    font-size: 0.95rem;
    background: #fff;
  }
  .stay-experience {
    background: #fff;
    position: relative;
  }
  .escape-pin {
    height: min(820px, calc(100svh - var(--header-height)));
    min-height: 520px;
  }
  .escape-window {
    position: relative;
    isolation: isolate;
    height: 100%;
    overflow: clip;
    clip-path: inset(2% 4% 2% 4% round 28px);
    background: #1c302b;
  }
  .escape-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .escape-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #0a151e33, transparent 28%, #071321b3);
  }
  .escape-topline,
  .escape-bottomline {
    position: absolute;
    left: 7%;
    right: 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: white;
    font-size: 0.8125rem;
    font-weight: 500;
    text-shadow: 0 1px 10px #00000055;
  }
  .escape-topline {
    top: 8%;
  }
  .escape-topline > span:last-child {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .escape-bottomline {
    bottom: 8%;
  }
  .escape-copy {
    position: absolute;
    left: 7%;
    bottom: 19%;
    max-width: 60%;
    color: white;
    text-shadow: 0 2px 18px #0000004d;
  }
  .escape-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    color: #ffffffe6;
  }
  .escape-copy h2 {
    font-size: clamp(2.8rem, 5.8vw, 6rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  .escape-copy > p:last-child {
    margin-top: 1.2rem;
    font-size: 1rem;
    line-height: 1.7;
    color: #ffffffe6;
  }
  .escape-seal {
    position: absolute;
    right: 7%;
    bottom: 20%;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: #fffffff0;
    color: var(--color-dark);
    box-shadow: 0 18px 48px #00000033;
    backdrop-filter: blur(8px);
  }
  .seal-ring {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .seal-ring-spin {
    transform-origin: 100px 100px;
  }
  .seal-ring-text {
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.18em;
    fill: #3d4d74;
  }
  .seal-zero {
    font-family: var(--font-display);
    font-size: 66px;
    font-weight: 700;
    letter-spacing: -0.04em;
    fill: var(--color-primary);
    transform: translateY(24px);
  }
  .seal-pct {
    font-size: 34px;
    letter-spacing: 0;
  }
  .seal-pill {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-enabled) .seal-ring-spin {
      animation: seal-spin 36s linear infinite;
    }
    @keyframes seal-spin {
      to {
        transform: rotate(360deg);
      }
    }
  }
  .escape-progress {
    height: 2px;
    background: #ffffff40;
    width: 120px;
    overflow: hidden;
  }
  .escape-progress i {
    display: block;
    height: 100%;
    background: white;
    transform-origin: left;
    transform: scaleX(var(--scene-progress, 1));
  }
  :global(.motion-enabled) .stay-experience {
    height: 175svh;
  }
  :global(.motion-enabled) .escape-pin {
    position: sticky;
    top: var(--header-height);
    height: calc(100svh - var(--header-height));
    min-height: 0;
  }
  :global(.motion-enabled) .escape-window {
    clip-path: inset(
      calc(3% * (1 - var(--open, 0))) calc(8% * (1 - var(--open, 0)))
        calc(3% * (1 - var(--open, 0))) calc(8% * (1 - var(--open, 0))) round
        calc(32px * (1 - var(--open, 0)))
    );
  }
  :global(.motion-enabled) .escape-photo {
    transform: scale(calc(1.14 - 0.14 * var(--scene-progress, 0)));
  }
  :global(.motion-enabled) .escape-copy {
    transform: translate3d(0, calc(38px * (1 - var(--copy, 0))), 0);
    opacity: var(--copy, 0);
  }
  :global(.motion-enabled) .escape-seal {
    transform: translate3d(0, calc(50px * (1 - var(--copy, 0))), 0)
      scale(calc(0.9 + 0.1 * var(--copy, 0)));
    opacity: var(--copy, 0);
  }
  :global(.motion-enabled) .escape-topline,
  :global(.motion-enabled) .escape-bottomline {
    left: calc(7% + 5% * (1 - var(--open, 0)));
    right: calc(7% + 5% * (1 - var(--open, 0)));
  }
  .search-strip {
    display: grid;
    grid-template-columns: 1fr 1.2fr 0.8fr;
    gap: 2rem;
    align-items: center;
    padding: 2.2rem 0;
    border-bottom: 1px solid var(--color-outline-variant);
  }
  .search-strip > div strong {
    display: block;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .search-strip > div > span {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }
  .search-strip form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.4rem 0.4rem 0.4rem 1.1rem;
    border: 1px solid #d7dfec;
    border-radius: 100px;
    background: white;
    transition: box-shadow 0.2s;
  }
  .search-strip form:focus-within {
    box-shadow: 0 0 0 4px #315ed21f;
    border-color: var(--color-primary);
  }
  .search-strip form > .icon {
    width: 1.15rem;
    color: #657087;
  }
  .search-strip input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    font-size: 0.9375rem;
    padding: 0.5rem 0;
  }
  .search-strip input:focus {
    outline: none;
  }
  .search-strip button {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border: 0;
    border-radius: 50%;
    color: white;
    background: var(--color-primary);
  }
  .search-strip button:hover {
    background: #1c43a2;
  }
  .search-strip button .icon {
    width: 1.1rem;
  }
  .search-strip > a {
    justify-self: end;
    text-align: right;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }
  .search-strip > a span {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-primary);
    font-weight: 600;
  }
  .search-strip > a .icon {
    width: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .headline-line > span {
      animation: headline-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .commission-number {
      animation: number-in 1.1s 0.08s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .commission-label {
      animation: intro-in 0.9s 0.18s both;
    }
    @keyframes number-in {
      from {
        opacity: 0;
        transform: translateY(22px) scale(0.92) rotate(3deg);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1) rotate(0);
      }
    }
    .hero-enter {
      animation: intro-in 0.9s 0.25s both;
    }
    .hero .actions {
      animation-delay: 0.35s;
    }
    .scroll-cue {
      animation-delay: 0.45s;
    }
    @keyframes headline-in {
      from {
        transform: translateY(115%) rotate(2deg);
      }
      to {
        transform: translateY(0) rotate(0);
      }
    }
    @keyframes intro-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  @media (min-width: 1600px) {
    .hero {
      padding-top: 4.5rem;
    }
  }
  @media (max-width: 860px) {
    .hero {
      padding-top: 3.5rem;
    }
    .search-strip {
      grid-template-columns: 1fr auto;
      gap: 1.2rem;
    }
    .search-strip form {
      grid-column: 1/-1;
      grid-row: 2;
    }
    .escape-copy {
      max-width: 70%;
    }
    .escape-seal {
      width: 150px;
      height: 150px;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-top: 2.3rem;
      padding-bottom: 0.8rem;
    }
    .hero .eyebrow {
      font-size: 0.75rem;
      margin-bottom: 1.1rem;
    }
    .headline-line {
      font-size: 2.6rem;
      margin-bottom: 0.5rem;
    }
    .commission-offer {
      gap: 1rem;
      padding-block: 0.5rem;
    }
    .commission-number {
      font-size: clamp(5.6rem, 22vw, 7.5rem);
      padding: 0.04em 0.1em 0.1em;
    }
    .commission-number::before {
      border-radius: 13px;
    }
    .commission-label {
      font-size: clamp(1.65rem, 6.4vw, 2.4rem);
    }
    .hero-lede {
      font-size: 0.9375rem;
      margin-top: 1.25rem;
    }
    .hero .actions {
      gap: 0.65rem;
      margin-top: 1.35rem;
    }
    .hero .btn {
      font-size: 0.875rem;
      min-height: 48px;
      padding: 0.75rem 1.15rem;
      gap: 0.55rem;
    }
    .scroll-cue {
      margin-top: 1.75rem;
      font-size: 0.75rem;
    }
    .escape-pin {
      min-height: 540px;
    }
    :global(.motion-enabled) .stay-experience {
      height: 140svh;
    }
    .escape-copy {
      bottom: 22%;
      left: 7%;
      max-width: 86%;
    }
    .escape-copy h2 {
      font-size: clamp(2.1rem, 9.5vw, 3.6rem);
    }
    .escape-copy > p:last-child {
      font-size: 0.875rem;
    }
    .escape-eyebrow {
      font-size: 0.6875rem;
      margin-bottom: 0.9rem;
    }
    .escape-seal {
      top: 8%;
      right: 7%;
      bottom: auto;
      width: auto;
      height: auto;
      border-radius: 100px;
      box-shadow: 0 10px 28px #00000033;
    }
    .seal-ring {
      display: none;
    }
    .seal-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 0.85rem 0.45rem 0.75rem;
    }
    .seal-pill strong {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--color-primary);
    }
    .seal-pill span {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }
    .escape-topline,
    .escape-progress {
      display: none;
    }
    .escape-bottomline {
      font-size: 0.75rem;
      bottom: 8%;
    }
    .search-strip {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-block: 1.5rem;
    }
    .search-strip form {
      grid-row: auto;
    }
    .search-strip > div strong {
      font-size: 0.9375rem;
    }
    .search-strip > div > span,
    .search-strip > a {
      font-size: 0.875rem;
    }
    .search-strip > a {
      justify-self: start;
      text-align: left;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem 0.6rem;
    }
    .search-strip > a span {
      justify-content: flex-start;
      font-size: 0.9375rem;
    }
  }
  @media (max-width: 360px) {
    .headline-line {
      font-size: 2.3rem;
    }
    .commission-offer {
      gap: 0.65rem;
      padding-inline: 0;
    }
    .commission-number {
      font-size: 5rem;
    }
    .commission-label {
      font-size: 1.45rem;
    }
    .hero .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .hero .btn {
      padding: 0.7rem 0.5rem;
      font-size: 0.8125rem;
      gap: 0.4rem;
      white-space: nowrap;
    }
    .hero .btn :global(.icon) {
      display: none;
    }
  }
  @media (max-height: 560px) and (min-width: 700px) {
    .escape-copy h2 {
      font-size: 3rem;
    }
    .escape-copy > p:last-child,
    .escape-eyebrow {
      display: none;
    }
    .escape-seal {
      width: 124px;
      height: 124px;
    }
  }
</style>
