---
import Icon from '../Icon.astro';

const points = [
  'Drag-and-drop sections, your own photos and videos',
  'Rooms with full details, and places to visit nearby',
  'A blog, and your own colours',
  'A booking widget — bookings come straight to you, at 0% commission',
];
---

<section class="section" aria-labelledby="own-website-heading">
  <div class="container">
    <div class="own-website card card-pad-lg">
      <div class="own-website-copy">
        <p class="eyebrow">Free to set up</p>
        <h2 class="display-2" id="own-website-heading">Your own website</h2>
        <p class="lede">
          Every StayKeep owner can set up a website at <strong>yourname.staykeep.com</strong> —
          no separate developer, no separate fee.
        </p>
        <ul class="own-website-list">
          {points.map((point) => (
            <li>
              <Icon name="check" size={18} class="check-yes" />
              <span class="body-text">{point}</span>
            </li>
          ))}
        </ul>
        <a href="/owners" class="btn btn-primary">
          See it for owners
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <div class="own-website-visual" aria-hidden="true">
        <div class="browser-frame">
          <div class="browser-chrome">
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-url">yourname.staykeep.com</span>
          </div>
          <div class="browser-body">
            <div class="browser-hero"></div>
            <div class="browser-line browser-line-wide"></div>
            <div class="browser-line browser-line-mid"></div>
            <div class="browser-cards">
              <div class="browser-card"></div>
              <div class="browser-card"></div>
              <div class="browser-card"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .own-website {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: center;
  }

  .own-website-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: var(--space-md);
  }

  .own-website-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .own-website-copy .btn {
    margin-top: var(--space-lg);
  }

  .browser-frame {
    border-radius: var(--radius-card-sm);
    overflow: hidden;
    background: var(--color-surface-lowest);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-outline-variant);
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-surface-container);
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-outline-variant);
  }

  .browser-url {
    margin-left: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
    background: var(--color-surface-lowest);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.7rem;
  }

  .browser-body {
    padding: 1.1rem;
  }

  .browser-hero {
    height: 5rem;
    border-radius: var(--radius-card-sm);
    background: linear-gradient(135deg, var(--color-primary-container), var(--color-surface-container-high));
    margin-bottom: 0.9rem;
  }

  .browser-line {
    height: 10px;
    border-radius: var(--radius-pill);
    background: var(--color-outline-variant);
    margin-bottom: 0.55rem;
  }

  .browser-line-wide {
    width: 80%;
  }

  .browser-line-mid {
    width: 55%;
  }

  .browser-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .browser-card {
    aspect-ratio: 1;
    border-radius: 12px;
    background: var(--color-surface-container);
  }

  @media (min-width: 900px) {
    .own-website {
      grid-template-columns: 1.1fr 1fr;
    }
  }
</style>
