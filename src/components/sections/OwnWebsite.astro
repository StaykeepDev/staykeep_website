---
import Icon from '../Icon.astro';
import PhoneShot from '../PhoneShot.astro';
import websitePreviewPhoneImg from '../../assets/screenshots/website-preview-phone.png';

const points = [
  'Drag-and-drop sections, your own photos and videos',
  'Rooms with full details, and places to visit nearby',
  'A blog, and your own colours',
  'A booking widget — bookings come straight to you, at 0% commission',
];
---

<section class="section" aria-labelledby="own-website-heading">
  <div class="container">
    <div class="own-website card card-pad-lg">
      <div class="own-website-copy">
        <p class="eyebrow">Free to set up</p>
        <h2 class="display-2" id="own-website-heading">Your own website</h2>
        <p class="lede">
          Every StayKeep owner can set up a website at <strong>yourname.staykeep.com</strong> —
          no separate developer, no separate fee.
        </p>
        <ul class="own-website-list">
          {points.map((point) => (
            <li>
              <Icon name="check" size={18} class="check-yes" />
              <span class="body-text">{point}</span>
            </li>
          ))}
        </ul>
        <a href="/owners" class="btn btn-primary">
          See it for owners
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      <PhoneShot
        src={websitePreviewPhoneImg}
        alt="Lakeview Homestay's real StayKeep website, shown on a phone: a teal hero with the property name, Alappuzha Kerala, and a Check availability button"
        widths={[280, 420]}
        sizes="(min-width: 900px) 280px, 60vw"
      />
    </div>
  </div>
</section>

<style>
  .own-website {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: center;
  }

  .own-website-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: var(--space-md);
  }

  .own-website-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .own-website-copy .btn {
    margin-top: var(--space-lg);
  }

  @media (min-width: 900px) {
    .own-website {
      grid-template-columns: 1.1fr 1fr;
    }
  }
</style>
