---
import Icon from "../Icon.astro";
import type { FeatureItem } from "../../content/features";
interface Props {
  eyebrow: string;
  heading: string;
  lede?: string;
  items: FeatureItem[];
  id?: string;
}
const {
  eyebrow,
  heading,
  lede,
  items,
  id = "feature-list-heading",
} = Astro.props;
---

<section class="section features-section" aria-labelledby={id}>
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="display-2" id={id}>
        {heading}
      </h2>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <ul class="feature-grid">
      {items.map((item) => (
        <li>
          <Icon name={item.icon} />
          <h3 class="display-4">{item.title}</h3>
          <p class="body-text">{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .features-section {
    background: #f6f8fc;
  }
  .feature-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 3rem;
  }
  .feature-grid li {
    border-top: 1px solid #dce3ef;
    padding-top: 1.5rem;
  }
  .feature-grid li > .icon {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }
  .feature-grid h3 {
    font-size: 1.1rem;
    line-height: 1.4;
  }
  .feature-grid p {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  @media (max-width: 950px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 580px) {
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
