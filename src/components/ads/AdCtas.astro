---
/**
 * The ad landing CTAs: one primary WhatsApp button, Call as the secondary,
 * and self sign-up as a small text link. `data-cta` + `data-cta-location`
 * drive the GA4 events and Google Ads conversions in Analytics.astro;
 * `data-cta="signup"` links also get the ad's utm_* and gclid (see
 * homestay-software.astro).
 */
import Icon from "../Icon.astro";
import { MANAGE_URL, CONTACT_PHONE_TEL, CONTACT_PHONE_DISPLAY } from "../../content/site";
import { WHATSAPP_URL } from "../../content/ads";
interface Props {
  location: "hero" | "footer";
}
const { location } = Astro.props;
---

<div class="ad-ctas">
  <a
    href={WHATSAPP_URL}
    class="btn btn-primary ad-cta-main"
    target="_blank"
    rel="noopener"
    data-cta="whatsapp"
    data-cta-location={location}
  >
    <Icon name="chat" /> WhatsApp your Maps link
  </a>
  <a
    href={CONTACT_PHONE_TEL}
    class="btn btn-outline"
    data-cta="call"
    data-cta-location={location}
  >
    <Icon name="phone" /> Call {CONTACT_PHONE_DISPLAY}
  </a>
</div>
<p class="ad-diy">
  Prefer to do it yourself?{" "}
  <a
    href={MANAGE_URL}
    class="text-link"
    data-cta="signup"
    data-cta-location={location}>Sign up</a
  >
</p>
<style>
  .ad-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .ad-ctas .btn-outline {
    background: white;
  }
  .ad-ctas .icon {
    width: 1.15rem;
    height: 1.15rem;
  }
  .ad-diy {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--color-on-surface-variant);
  }
  @media (max-width: 560px) {
    .ad-ctas {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
