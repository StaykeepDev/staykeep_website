---
import Icon from "../Icon.astro";
import DemoPlayer from "./DemoPlayer.astro";
---

<DemoPlayer
  name="property website"
  kind="website"
  description="An illustrated property website for Lakeview: the page scrolls from a lakeside retreat to a Lake suite, then shows a confirmed two-night direct booking for ₹5,000 with ₹0 booking fee."
>
  <div class="property-demo">
    <div class="browser-bar">
      <div class="window-dots">
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span>
        <Icon name="shield-check" /> lakeview.staykeep.com
      </span>
      <Icon name="arrow-right" />
    </div>
    <div class="property-nav">
      <span class="lakeview-wordmark">
        Lakeview<span>A LITTLE CLOSER TO NATURE</span>
      </span>
      <span class="mini-book">
        Book your stay <Icon name="arrow-right" />
      </span>
    </div>
    <div class="property-viewport">
      <div class="property-page" data-demo-animate>
        <div class="property-hero">
          <span class="property-kicker">YOUR QUIET CORNER OF THE WORLD</span>
          <p>
            Slow mornings.
            <br />A lake of your own.
          </p>
          <span>A small escape. A lasting memory.</span>
        </div>
        <div class="lake-illustration">
          <svg viewBox="0 0 640 310" role="presentation" aria-hidden="true">
            <path fill="#e7e9ef" d="M0 0h640v310H0z" />
            <circle cx="480" cy="76" r="44" fill="#f2d198" />
            <path
              fill="#b8c7ce"
              d="m0 168 76-79 70 46 100-82 108 120 103-63 83 26 100-72v246H0Z"
            />
            <path
              fill="#8ea8b0"
              d="m0 178 134-57 94 77 120-74 104 57 123-35 65 35v129H0Z"
            />
            <path
              fill="#aac5ce"
              d="M0 206c114-18 219 8 320-2s214-21 320-5v111H0Z"
            />
            <path
              d="M398 227h162M435 240h110M363 253h162M488 271h90M338 282h88"
              stroke="#e8f0ef"
              stroke-width="3"
              stroke-linecap="round"
              opacity=".65"
            />
            <path fill="#78958a" d="M0 233c133-27 211-8 362 77H0Z" />
            <path fill="#e2d3b7" d="m42 264 196-57 183 103H155Z" />
            <path fill="#eee6d7" d="M104 139h136v119H104Z" />
            <path fill="#dbc6a6" d="m240 139 74 37v74l-74 8Z" />
            <path fill="#445967" d="m86 141 87-85 90 85Z" />
            <path fill="#61767e" d="m173 56 82 29 76 93-68-37Z" />
            <path fill="#455d63" d="M124 163h40v65h-40ZM180 163h40v93h-40Z" />
            <path fill="#bbd1d1" d="M128 167h32v43h-32ZM184 167h32v63h-32Z" />
            <path
              stroke="#eee6d7"
              stroke-width="3"
              d="M144 167v43M128 188h32M200 167v63M184 199h32"
            />
            <path fill="#a79678" d="M265 177h24v43h-24Z" />
            <path fill="#d6e0dc" d="M269 181h16v35h-16Z" />
            <path fill="#f4ecdc" d="m238 251 98-14 27 12-119 16Z" />
            <path
              stroke="#a18e71"
              stroke-width="4"
              d="M244 265v19M331 249v23"
            />
            <path
              fill="#46695f"
              d="M30 226 63 112l33 114ZM530 211l38-150 41 150Z"
            />
            <path
              fill="#587e6e"
              d="m-20 243 50-162 48 162ZM590 217l34-125 37 125Z"
            />
            <path
              stroke="#607165"
              stroke-width="5"
              d="M63 219v40M569 193v35M624 209v21M30 229v43"
            />
          </svg>
          <span class="illustration-label">
            <Icon name="map-pin" /> Beside the water. Away from the rush.
          </span>
        </div>
        <div class="stay-details">
          <span>
            <Icon name="users" /> Made for two
          </span>
          <span>
            <Icon name="sparkle" /> A slower pace
          </span>
          <span>
            <Icon name="key" /> Book directly
          </span>
        </div>
        <div class="rooms-section">
          <div class="rooms-heading">
            <span>MAKE YOURSELF AT HOME</span>
            <p>Your room is ready.</p>
          </div>
          <div class="room-preview">
            <div class="room-art">
              <div class="room-window">
                <i></i>
              </div>
              <div class="room-bed">
                <i></i>
                <i></i>
              </div>
              <div class="room-lamp"></div>
            </div>
            <div class="room-preview-copy">
              <strong>The Lake suite</strong>
              <span>Private balcony · 2 guests</span>
              <p>
                ₹2,500 <small>/ night</small>
              </p>
              <span class="choose-room">
                Choose your room <Icon name="arrow-right" />
              </span>
            </div>
          </div>
          <div class="room-dates">
            <span>
              CHECK-IN<strong>12 Oct</strong>
            </span>
            <span>
              CHECK-OUT<strong>14 Oct</strong>
            </span>
            <span>
              GUESTS<strong>2 adults</strong>
            </span>
            <span class="reserve-preview">
              Reserve <Icon name="arrow-right" />
            </span>
          </div>
        </div>
        <div class="site-signoff">Good days begin here.</div>
      </div>
      <svg
        class="demo-cursor"
        data-demo-animate
        viewBox="0 0 24 30"
        aria-hidden="true"
      >
        <path
          d="m3 2 18 14-9 1-4 9Z"
          fill="#263850"
          stroke="#fff"
          stroke-width="2"
          stroke-linejoin="round"
        />
      </svg>
      <div class="confirmation-scrim" data-demo-animate></div>
      <div class="booking-confirmation" data-demo-animate>
        <span class="confirmation-check">
          <Icon name="check" />
        </span>
        <span class="confirmation-kicker">YOU’RE GOING TO LAKEVIEW</span>
        <p>
          A little escape.
          <br />
          All yours.
        </p>
        <span class="confirmation-detail">
          The Lake suite · 12–14 October
          <br />2 nights · 2 guests
        </span>
        <div class="confirmation-total">
          <span>
            Your stay<strong>₹5,000</strong>
          </span>
          <span>
            Booking fee<strong>₹0</strong>
          </span>
        </div>
        <div class="confirmation-success">
          <Icon name="shield-check" /> Booking confirmed
        </div>
        <small>Illustrative price. Taxes and other charges excluded.</small>
      </div>
    </div>
    <div class="website-demo-footer">
      <span class="website-flow-step browse-step" data-demo-animate>
        <b>01</b> Explore your stay
      </span>
      <span class="website-flow-step choose-step" data-demo-animate>
        <b>02</b> Find your room
      </span>
      <span class="website-flow-step confirmed-step" data-demo-animate>
        <b>03</b> Book direct. Keep more.
      </span>
      <span class="powered-by">
        Made with <strong>StayKeep</strong>
      </span>
    </div>
  </div>
</DemoPlayer>

<style>
  .property-demo {
    --preview-height: clamp(365px, 76cqw, 460px);
    background: #fbf9f3;
    color: #34443f;
    font-size: clamp(10px, 2.1cqw, 13px);
    line-height: 1.5;
  }
  .property-demo :global(.icon) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .browser-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 18px;
    background: #fff;
    border-bottom: 1px solid #ebebe7;
    color: #8f989f;
    font-size: 0.75em;
  }
  .browser-bar > span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .browser-bar > span :global(.icon) {
    width: 11px;
    height: 11px;
  }
  .browser-bar > :global(.icon) {
    width: 12px;
    height: 12px;
    color: #b9c0c9;
  }
  .window-dots {
    display: flex;
    gap: 4px;
  }
  .window-dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #dfe4ea;
  }
  .window-dots i:first-child {
    background: #e7b8a8;
  }
  .window-dots i:nth-child(2) {
    background: #e5d49d;
  }
  .property-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 6%;
    position: relative;
    z-index: 2;
    border-bottom: 1px solid #e9e7df;
  }
  .lakeview-wordmark {
    font-family: Georgia, serif;
    font-size: 2.2em;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .lakeview-wordmark > span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.19em;
    letter-spacing: 0.19em;
    margin-top: 7px;
  }
  .mini-book {
    background: #344e4c;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 5px;
    font-size: 0.74em;
  }
  .mini-book :global(.icon) {
    width: 11px;
    height: 11px;
  }
  .property-viewport {
    height: var(--preview-height);
    position: relative;
    overflow: hidden;
  }
  .property-page {
    transform: translateY(calc(-100% + var(--preview-height) - 15px));
  }
  .property-hero {
    text-align: center;
    padding: 30px 18px 26px;
  }
  .property-kicker {
    display: block;
    font-size: 0.5em;
    letter-spacing: 0.19em;
    color: #929285;
    margin-bottom: 12px;
  }
  .property-hero p {
    font-family: Georgia, serif;
    font-size: 3.35em;
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.06em;
    margin-bottom: 13px;
  }
  .property-hero > span:last-child {
    font-size: 0.8em;
    color: #8e9388;
  }
  .lake-illustration {
    margin-inline: 6%;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .lake-illustration svg {
    width: 100%;
    height: auto;
  }
  .illustration-label {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 4px;
    background: #fbf9f3e8;
    color: #536859;
    font-size: 0.55em;
  }
  .illustration-label :global(.icon) {
    width: 9px;
    height: 9px;
  }
  .stay-details {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 19px 10px;
    font-size: 0.6em;
    color: #7d887c;
    border-bottom: 1px solid #e9e8de;
  }
  .stay-details > span {
    display: flex;
    gap: 5px;
    align-items: center;
    white-space: nowrap;
  }
  .stay-details :global(.icon) {
    width: 11px;
    height: 11px;
    color: #a3997b;
  }
  .rooms-section {
    padding: 28px 6%;
  }
  .rooms-heading > span {
    font-size: 0.5em;
    letter-spacing: 0.18em;
    color: #999b8c;
  }
  .rooms-heading > p {
    font-family: Georgia, serif;
    font-size: 2.4em;
    letter-spacing: -0.055em;
    margin: 6px 0 16px;
  }
  .room-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: center;
  }
  .room-art {
    height: 136px;
    background: #e1d5c2;
    border-radius: 5px;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 -38px #bcab95;
  }
  .room-window {
    position: absolute;
    width: 36%;
    height: 57%;
    left: 12%;
    top: 10%;
    background: #a3bec1;
    border: 5px solid #f1e6d4;
    overflow: hidden;
    box-shadow: 4px 4px #b9a88d33;
  }
  .room-window::before,
  .room-window::after {
    content: "";
    position: absolute;
    width: 110%;
    height: 70%;
    background: #7f9e8d;
    border-radius: 40%;
    bottom: -20%;
    left: -40%;
    transform: rotate(25deg);
  }
  .room-window::after {
    left: 40%;
    bottom: -10%;
    background: #94aa91;
    transform: rotate(-20deg);
  }
  .room-window i {
    width: 3px;
    height: 100%;
    background: #f1e6d4;
    position: absolute;
    left: 50%;
    z-index: 1;
  }
  .room-bed {
    position: absolute;
    right: -8%;
    bottom: 18%;
    width: 66%;
    height: 39%;
    border-radius: 5px;
    background: #f4eddf;
    transform: skewY(-7deg);
    box-shadow:
      0 8px #cfc2ab,
      0 11px #7f7e6e;
  }
  .room-bed::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    height: 100%;
    background: #849695;
    opacity: 0.65;
  }
  .room-bed i {
    position: absolute;
    width: 26%;
    height: 28%;
    top: 7%;
    left: 7%;
    background: #fffaf1;
    border-radius: 4px;
  }
  .room-bed i + i {
    top: 48%;
  }
  .room-lamp {
    position: absolute;
    height: 24%;
    width: 2px;
    background: #8f846e;
    top: 35%;
    right: 16%;
  }
  .room-lamp::before {
    content: "";
    position: absolute;
    width: 20px;
    height: 14px;
    background: #f5e5bd;
    left: -9px;
    top: -5px;
    border-radius: 50% 50% 0 0;
  }
  .room-preview-copy strong {
    font-family: Georgia, serif;
    font-size: 1.55em;
    font-weight: 400;
    letter-spacing: -0.03em;
  }
  .room-preview-copy > span {
    display: block;
    font-size: 0.66em;
    color: #93978b;
    margin-top: 4px;
  }
  .room-preview-copy > p {
    margin-block: 12px;
    font-size: 1.15em;
  }
  .room-preview-copy small {
    font-size: 0.65em;
    color: #909688;
  }
  .room-preview-copy .choose-room {
    display: flex;
    gap: 5px;
    align-items: center;
    color: #536b5c;
    font-size: 0.75em;
    font-weight: 600;
  }
  .choose-room :global(.icon) {
    width: 11px;
    height: 11px;
  }
  .room-dates {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.1fr;
    gap: 8px;
    padding: 16px 12px;
    background: #fff;
    border: 1px solid #e7e7dc;
    border-radius: 5px;
    margin-top: 22px;
    align-items: center;
  }
  .room-dates > span {
    font-size: 0.5em;
    color: #9a9d92;
    letter-spacing: 0.04em;
  }
  .room-dates strong {
    display: block;
    font-size: 1.5em;
    font-weight: 500;
    margin-top: 4px;
    letter-spacing: 0;
    color: #54604f;
  }
  .room-dates .reserve-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-size: 0.65em;
    padding: 10px 4px;
    background: #344e4c;
    color: #fff;
    border-radius: 4px;
    letter-spacing: 0;
  }
  .reserve-preview :global(.icon) {
    width: 10px;
    height: 10px;
  }
  .site-signoff {
    padding: 10px 20px 40px;
    text-align: center;
    font-family: Georgia, serif;
    font-size: 1.5em;
    color: #949b8d;
  }
  .demo-cursor {
    position: absolute;
    width: 23px;
    height: 30px;
    right: 15%;
    bottom: 29%;
    z-index: 4;
    opacity: 0;
    filter: drop-shadow(0 2px 2px #1a2e4222);
  }
  .confirmation-scrim {
    position: absolute;
    inset: 0;
    background: #f6f4edb8;
    backdrop-filter: blur(3px);
  }
  .booking-confirmation {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 77%;
    max-width: 330px;
    transform: translate(-50%, -50%);
    border: 1px solid #e1e4d9;
    border-radius: 13px;
    padding: 23px 18px 14px;
    background: #fffefa;
    text-align: center;
    box-shadow: 0 22px 50px #52604720;
  }
  .confirmation-check {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    margin: 0 auto 13px;
    background: #edf1e6;
    color: #748565;
  }
  .confirmation-check :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .confirmation-kicker {
    font-size: 0.54em;
    letter-spacing: 0.15em;
    color: #9b9e8d;
  }
  .booking-confirmation > p {
    font-family: Georgia, serif;
    font-size: 2.9em;
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin: 12px 0;
  }
  .confirmation-detail {
    font-size: 0.76em;
    color: #8c9486;
    line-height: 1.7;
  }
  .confirmation-total {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 13px 0;
    margin-top: 17px;
    border-block: 1px dashed #e0e4d8;
  }
  .confirmation-total > span {
    font-size: 0.67em;
    color: #9b9f8f;
  }
  .confirmation-total > span + span {
    border-left: 1px solid #eceee6;
  }
  .confirmation-total strong {
    display: block;
    color: #4d654f;
    font-size: 1.9em;
    font-weight: 550;
    margin-top: 5px;
    letter-spacing: -0.03em;
  }
  .confirmation-success {
    display: flex;
    justify-content: center;
    gap: 5px;
    align-items: center;
    font-size: 0.8em;
    margin-top: 14px;
    color: #798865;
  }
  .booking-confirmation > small {
    display: block;
    font-size: 0.48em;
    color: #9d9f95;
    margin-top: 12px;
  }
  .website-demo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    position: relative;
    height: 43px;
    padding-inline: 6%;
    background: #fbf9f3;
    border-top: 1px solid #e9e7df;
    font-size: 0.6em;
  }
  .website-flow-step {
    position: absolute;
    opacity: 0;
    display: flex;
    gap: 6px;
    align-items: center;
    color: #6c7e6c;
  }
  .website-flow-step b {
    font-size: 0.9em;
    color: #a5ac97;
    font-weight: 500;
  }
  .confirmed-step {
    opacity: 1;
  }
  .powered-by {
    margin-left: auto;
    color: #a0a497;
  }
  .powered-by strong {
    font-weight: 650;
    color: #7c8877;
  }
  @container (max-width: 400px) {
    .property-demo {
      --preview-height: 375px;
    }
    .property-hero {
      padding-block: 25px;
    }
    .property-hero p {
      font-size: 3.3em;
    }
    .room-art {
      height: 106px;
    }
    .room-preview {
      gap: 14px;
    }
    .rooms-section {
      padding-block: 20px;
    }
    .stay-details {
      gap: 11px;
      font-size: 0.61em;
      padding-block: 15px;
    }
    .booking-confirmation {
      padding-top: 19px;
      width: 81%;
    }
    .booking-confirmation > small {
      font-size: 6px;
    }
    .confirmation-kicker {
      font-size: 0.62em;
    }
    .confirmation-detail {
      font-size: 0.9em;
    }
    .confirmation-total > span {
      font-size: 0.8em;
    }
    .website-demo-footer {
      font-size: 0.65em;
    }
    .browser-bar {
      padding-inline: 14px;
    }
  }
  :global(.is-started) .property-page {
    animation-name: scroll-property;
  }
  :global(.is-started) .demo-cursor {
    animation-name: choose-stay;
  }
  :global(.is-started) .confirmation-scrim {
    animation-name: website-scrim;
  }
  :global(.is-started) .booking-confirmation {
    animation-name: confirm-stay;
  }
  :global(.is-started) .browse-step {
    animation-name: step-browse;
  }
  :global(.is-started) .choose-step {
    animation-name: step-choose;
  }
  :global(.is-started) .confirmed-step {
    animation-name: step-confirmed;
  }
  @keyframes scroll-property {
    0%,
    18% {
      transform: translateY(0);
    }
    42%,
    100% {
      transform: translateY(calc(-100% + var(--preview-height) - 15px));
    }
  }
  @keyframes choose-stay {
    0%,
    40% {
      opacity: 0;
      transform: translate(15px, 25px);
    }
    48%,
    53% {
      opacity: 1;
      transform: translate(0, 0);
    }
    56% {
      opacity: 1;
      transform: scale(0.8);
    }
    59% {
      opacity: 1;
      transform: scale(1);
    }
    65%,
    100% {
      opacity: 0;
    }
  }
  @keyframes website-scrim {
    0%,
    58% {
      opacity: 0;
    }
    70%,
    100% {
      opacity: 1;
    }
  }
  @keyframes confirm-stay {
    0%,
    58% {
      opacity: 0;
      transform: translate(-50%, -43%) scale(0.94);
    }
    73%,
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }
  @keyframes step-browse {
    0%,
    27% {
      opacity: 1;
    }
    34%,
    100% {
      opacity: 0;
    }
  }
  @keyframes step-choose {
    0%,
    27% {
      opacity: 0;
    }
    34%,
    61% {
      opacity: 1;
    }
    68%,
    100% {
      opacity: 0;
    }
  }
  @keyframes step-confirmed {
    0%,
    61% {
      opacity: 0;
    }
    68%,
    100% {
      opacity: 1;
    }
  }
</style>
