---
interface Props {
  size?: number;
  class?: string;
}

const { size = 30, class: className = '' } = Astro.props;
---

<a href="/" class={`sk-logo ${className}`} aria-label="StayKeep home">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="16" cy="16" r="16" fill="var(--color-primary)"></circle>
    <circle cx="16" cy="12.6" r="3.4" fill="var(--color-on-primary)"></circle>
    <rect x="14.3" y="15" width="3.4" height="8.2" rx="1.7" fill="var(--color-on-primary)"
    ></rect>
  </svg>
  <span class="sk-logo-word">StayKeep</span>
</a>

<style>
  .sk-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .sk-logo-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    color: var(--color-on-surface);
    letter-spacing: -0.01em;
  }
</style>
