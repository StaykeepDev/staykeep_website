---
import { Image } from "astro:assets";
import bookingLogo from "../assets/brand/booking-app-logo-hq.png";
interface Props {
  size?: number;
  class?: string;
}
const { size = 38, class: className = "" } = Astro.props;
---

<a href="/" class={`sk-logo ${className}`} aria-label="StayKeep home">
  <Image
    src={bookingLogo}
    alt=""
    width={size}
    height={size}
    widths={[size * 2, size * 3, size * 4]}
    sizes={`${size}px`}
    quality={100}
    format="webp"
    loading="eager"
  />
  <span>StayKeep</span>
</a>
<style>
  .sk-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
    color: inherit;
    min-height: 44px;
  }
  .sk-logo span {
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .sk-logo img {
    flex-shrink: 0;
    clip-path: inset(1.4% round 24%);
  }
</style>
