---
import Logo from "./Logo.astro";
import {
  FOOTER_LINKS,
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_TEL,
} from "../content/site";
const year = new Date().getFullYear();
const columns = [
  { title: "Explore", links: FOOTER_LINKS.guests },
  { title: "For owners", links: FOOTER_LINKS.owners },
  { title: "StayKeep", links: FOOTER_LINKS.company },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo />
        <p>
          Good stays. Direct connections.
          <br />
          More for the people behind them.
        </p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        <a href={CONTACT_PHONE_TEL}>{CONTACT_PHONE_DISPLAY}</a>
      </div>
      {columns.map((col) => (
        <nav aria-label={col.title}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="footer-bottom">
      <p>© {year} StayKeep. All rights reserved.</p>
      <nav aria-label="Legal">
        {FOOTER_LINKS.legal.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: #14213d;
    color: #f4f6fc;
    --logo-key: #14213d;
    padding: 4.5rem 0 1.75rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 4rem;
  }
  .footer-brand p {
    color: #b5c0d5;
    font-size: 0.9375rem;
    margin: 1.5rem 0;
  }
  .footer-brand > a {
    display: block;
    font-size: 0.875rem;
    margin-top: 0.4rem;
  }
  .footer-grid nav h2 {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: #b5c0d5;
  }
  .footer-grid ul {
    list-style: none;
  }
  .footer-grid li {
    margin-bottom: 0.7rem;
    font-size: 0.875rem;
  }
  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .footer-bottom {
    border-top: 1px solid #ffffff25;
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: #b5c0d5;
  }
  .footer-bottom nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 1rem;
    }
    .footer-brand {
      grid-column: 1/-1;
    }
    .footer-bottom nav {
      gap: 1rem;
    }
    .site-footer {
      padding-top: 3rem;
    }
    .footer-grid {
      padding-bottom: 2rem;
    }
  }
</style>
