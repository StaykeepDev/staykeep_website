---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  /** A tighter, different crop shown below 700px instead of a shrunk desktop
   * shot — real art direction (a different image), not a resized one, since
   * shrinking the full desktop screenshot made its text illegible on a
   * phone (found in review). Also drops the browser-chrome bar: a close
   * crop doesn't read as "a browser window" any more. */
  mobileSrc?: ImageMetadata;
  alt: string;
  url?: string;
  widths?: number[];
  sizes?: string;
}

const {
  src,
  mobileSrc,
  alt,
  url = "manage.staykeep.com",
  widths,
  sizes,
} = Astro.props;

const desktopImg = await getImage({ src, widths, format: "webp" });
const mobileImg = mobileSrc
  ? await getImage({ src: mobileSrc, format: "webp" })
  : null;
---

<figure class={`browser-frame-shot ${mobileImg ? "has-mobile-crop" : ""}`}>
  <div class="browser-frame-chrome">
    <span class="browser-dot"></span>
    <span class="browser-dot"></span>
    <span class="browser-dot"></span>
    <span class="browser-frame-url">{url}</span>
  </div>
  <picture>
    {mobileImg && (
      <source
        media="(max-width: 699px)"
        srcset={mobileImg.src}
        width={mobileImg.attributes.width}
        height={mobileImg.attributes.height}
      />
    )}
    <img
      src={desktopImg.src}
      srcset={desktopImg.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      width={desktopImg.attributes.width}
      height={desktopImg.attributes.height}
      loading="lazy"
      decoding="async"
      class="browser-frame-img"
    />
  </picture>
</figure>

<style>
  .browser-frame-shot {
    margin: 0;
    border-radius: var(--radius-card-sm);
    overflow: hidden;
    background: var(--color-surface-lowest);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-outline-variant);
  }

  .browser-frame-chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    background: var(--color-surface-container);
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-outline-variant);
  }

  .browser-frame-url {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-on-surface-variant);
    background: var(--color-surface-lowest);
    border-radius: 6px;
    padding: 0.15rem 0.6rem;
  }

  .browser-frame-img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 699px) {
    .has-mobile-crop .browser-frame-chrome {
      display: none;
    }
  }
</style>
